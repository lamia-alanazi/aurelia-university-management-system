@model lamia12771.Models.Teacher

@{ ViewBag.Title = "Edit Teacher"; }

<style>
    .teachers-page {
        width: 100%;
        background: #ffffff;
        color: #111111;
        padding: 48px 0 70px;
        font-family: Arial, sans-serif;
    }

        .teachers-page * {
            box-sizing: border-box;
        }

        .teachers-page .teachers-shell {
            width: 90%;
            max-width: 1320px;
            margin: 0 auto;
        }

        .teachers-page .teachers-head {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            gap: 28px;
            margin-bottom: 30px;
        }

        .teachers-page .teachers-kicker {
            margin-bottom: 10px;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.8px;
            text-transform: uppercase;
            color: #777777;
        }

        .teachers-page .teachers-title {
            margin: 0 0 10px;
            font-family: 'Times New Roman', serif;
            font-size: 42px;
            font-weight: 400;
            line-height: 1.1;
            color: #111111;
        }

        .teachers-page .teachers-description {
            max-width: 580px;
            margin: 0;
            font-size: 12px;
            line-height: 1.75;
            color: #666666;
        }

        .teachers-page .teachers-add-btn,
        .teachers-page .teachers-add-btn:visited {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 44px;
            padding: 0 19px;
            border: 1px solid #3E4348;
            border-radius: 6px;
            background: #3E4348;
            color: #ffffff !important;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .55px;
            text-transform: uppercase;
            text-decoration: none !important;
            white-space: nowrap;
            transition: background .2s ease, border-color .2s ease, transform .2s ease;
        }

            .teachers-page .teachers-add-btn:hover,
            .teachers-page .teachers-add-btn:focus {
                background: #2F3438;
                border-color: #2F3438;
                color: #ffffff !important;
                text-decoration: none !important;
                transform: translateY(-1px);
            }

        .teachers-page .teachers-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 30px;
            padding-top: 22px;
            border-top: 1px solid #e3e3e0;
            flex-wrap: wrap;
        }

        .teachers-page .teachers-filters {
            display: flex;
            flex-wrap: wrap;
            gap: 9px;
        }

        .teachers-page .teacher-filter {
            padding: 9px 16px;
            border: 1px solid #d9d9d5;
            border-radius: 999px;
            background: #ffffff;
            color: #222222;
            font-size: 11px;
            font-weight: 600;
            cursor: pointer;
            transition: all .2s ease;
        }

            .teachers-page .teacher-filter:hover {
                border-color: #3E4348;
            }

            .teachers-page .teacher-filter.active {
                background: #3E4348;
                border-color: #3E4348;
                color: #ffffff;
            }

        .teachers-page .teachers-count {
            font-size: 10px;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: #777777;
            white-space: nowrap;
        }

        .teachers-page .teachers-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 22px;
        }

        .teachers-page .teacher-card {
            min-height: 190px;
            padding: 20px;
            border: 1px solid #deded9;
            border-radius: 9px;
            background: #ffffff;
            box-shadow: 0 10px 28px rgba(62, 67, 72, .07);
            transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
        }

            .teachers-page .teacher-card:hover {
                transform: translateY(-2px);
                border-color: #c9cbc8;
                box-shadow: 0 15px 34px rgba(62, 67, 72, .11);
            }

        .teachers-page .teacher-card-top {
            display: flex;
            gap: 16px;
            align-items: flex-start;
        }

        .teachers-page .teacher-avatar {
            width: 78px;
            height: 96px;
            flex: 0 0 78px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid #d3d5d4;
            border-radius: 7px;
            background: #eeeeec;
            color: #3E4348;
            font-family: 'Times New Roman', serif;
            font-size: 25px;
            text-transform: uppercase;
            overflow: hidden;
        }

        .teachers-page .teacher-card-info {
            min-width: 0;
            flex: 1;
        }

        .teachers-page .teacher-name {
            margin: 1px 0 5px;
            font-family: 'Times New Roman', serif;
            font-size: 20px;
            font-weight: 400;
            line-height: 1.2;
            color: #111111;
        }

        .teachers-page .teacher-role {
            margin-bottom: 4px;
            font-size: 11px;
            font-weight: 700;
            color: #222222;
        }

        .teachers-page .teacher-subject {
            font-size: 11px;
            line-height: 1.5;
            color: #777777;
        }

        .teachers-page .teacher-facts {
            display: flex;
            gap: 28px;
            margin-top: 14px;
            padding-top: 12px;
            border-top: 1px solid #ecece8;
        }

        .teachers-page .teacher-fact-value {
            margin-bottom: 2px;
            font-family: 'Times New Roman', serif;
            font-size: 17px;
            line-height: 1;
            color: #111111;
        }

        .teachers-page .teacher-fact-label {
            font-size: 9px;
            font-weight: 700;
            letter-spacing: .9px;
            text-transform: uppercase;
            color: #888888;
        }

        .teachers-page .teacher-actions {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 8px;
            margin-top: 16px;
            padding-top: 14px;
            border-top: 1px solid #ecece8;
            flex-wrap: wrap;
        }

        .teachers-page .teacher-action,
        .teachers-page .teacher-action:visited {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 8px 11px;
            border: 1px solid #d8d9d6;
            border-radius: 5px;
            background: #ffffff;
            color: #333333 !important;
            font-size: 9px;
            font-weight: 700;
            letter-spacing: .55px;
            text-transform: uppercase;
            text-decoration: none !important;
            transition: all .2s ease;
        }

            .teachers-page .teacher-action:hover {
                border-color: #3E4348;
                color: #111111 !important;
                text-decoration: none !important;
            }

            .teachers-page .teacher-action.primary {
                border-color: #3E4348;
                background: #3E4348;
                color: #ffffff !important;
            }

                .teachers-page .teacher-action.primary:hover {
                    background: #2F3438;
                    border-color: #2F3438;
                    color: #ffffff !important;
                }

            .teachers-page .teacher-action.danger {
                border-color: #c9aaaa;
                color: #8a3d3d !important;
            }

                .teachers-page .teacher-action.danger:hover {
                    border-color: #8a3d3d;
                    background: #8a3d3d;
                    color: #ffffff !important;
                }

        .teachers-page .teachers-empty {
            grid-column: 1 / -1;
            padding: 50px 25px;
            border: 1px dashed #d5d5d1;
            border-radius: 8px;
            background: #fafaf8;
            text-align: center;
            color: #777777;
            font-size: 12px;
        }

        .teachers-page .teacher-panel {
            max-width: 820px;
            margin: 0 auto;
            border: 1px solid #d9dad7;
            border-radius: 10px;
            background: #ffffff;
            box-shadow: 0 14px 35px rgba(62, 67, 72, .09);
            overflow: hidden;
        }

        .teachers-page .teacher-panel-head {
            padding: 26px 30px;
            background: #3E4348;
            color: #ffffff;
        }

            .teachers-page .teacher-panel-head .panel-kicker {
                margin-bottom: 7px;
                font-size: 9px;
                font-weight: 700;
                letter-spacing: 1.4px;
                text-transform: uppercase;
                color: rgba(255,255,255,.68);
            }

            .teachers-page .teacher-panel-head h2 {
                margin: 0;
                font-family: 'Times New Roman', serif;
                font-size: 29px;
                font-weight: 400;
                color: #ffffff;
            }

            .teachers-page .teacher-panel-head p {
                margin: 7px 0 0;
                font-size: 11px;
                line-height: 1.6;
                color: rgba(255,255,255,.74);
            }

        .teachers-page .teacher-panel-body {
            padding: 30px;
        }

        .teachers-page .teacher-form-group {
            margin-bottom: 22px;
        }

        .teachers-page .teacher-form-label {
            display: block;
            margin-bottom: 8px;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: .8px;
            text-transform: uppercase;
            color: #555555;
        }

        .teachers-page .teacher-input {
            width: 100%;
            height: 44px;
            padding: 10px 13px;
            border: 1px solid #d7d8d5;
            border-radius: 5px;
            background: #ffffff;
            color: #111111;
            font-size: 13px;
            outline: none;
            box-shadow: none;
            transition: border-color .2s ease, box-shadow .2s ease;
        }

            .teachers-page .teacher-input:focus {
                border-color: #3E4348;
                box-shadow: 0 0 0 3px rgba(62, 67, 72, .08);
            }

        .teachers-page .field-validation-error,
        .teachers-page .validation-summary-errors {
            color: #a04242;
            font-size: 11px;
        }

        .teachers-page .teacher-form-actions {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-top: 28px;
            padding-top: 22px;
            border-top: 1px solid #ecece8;
            flex-wrap: wrap;
        }

        .teachers-page .teacher-btn,
        .teachers-page .teacher-btn:visited {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 41px;
            padding: 0 17px;
            border-radius: 5px;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: .55px;
            text-transform: uppercase;
            text-decoration: none !important;
            cursor: pointer;
            transition: all .2s ease;
        }

        .teachers-page .teacher-btn-dark {
            border: 1px solid #3E4348;
            background: #3E4348;
            color: #ffffff !important;
        }

            .teachers-page .teacher-btn-dark:hover {
                background: #2F3438;
                border-color: #2F3438;
                color: #ffffff !important;
            }

        .teachers-page .teacher-btn-light {
            border: 1px solid #d5d6d3;
            background: #ffffff;
            color: #333333 !important;
        }

            .teachers-page .teacher-btn-light:hover {
                border-color: #3E4348;
                color: #111111 !important;
            }

        .teachers-page .teacher-btn-danger {
            border: 1px solid #8a3d3d;
            background: #8a3d3d;
            color: #ffffff !important;
        }

            .teachers-page .teacher-btn-danger:hover {
                background: #713030;
                border-color: #713030;
                color: #ffffff !important;
            }

        .teachers-page .teacher-profile-head {
            display: flex;
            align-items: center;
            gap: 19px;
        }

        .teachers-page .teacher-profile-avatar {
            width: 82px;
            height: 100px;
            flex: 0 0 82px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid rgba(255,255,255,.22);
            border-radius: 7px;
            background: rgba(255,255,255,.10);
            color: #ffffff;
            font-family: 'Times New Roman', serif;
            font-size: 27px;
            text-transform: uppercase;
        }

        .teachers-page .profile-section {
            margin-bottom: 28px;
        }

            .teachers-page .profile-section:last-child {
                margin-bottom: 0;
            }

        .teachers-page .profile-section-title {
            margin: 0 0 11px;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.1px;
            text-transform: uppercase;
            color: #858781;
        }

        .teachers-page .profile-text {
            margin: 0;
            font-size: 13px;
            line-height: 1.8;
            color: #2f2f2d;
        }

        .teachers-page .profile-facts {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 14px;
        }

        .teachers-page .profile-fact {
            padding: 16px;
            border: 1px solid #e0e1de;
            border-radius: 7px;
            background: #fafaf8;
        }

        .teachers-page .profile-fact-label {
            margin-bottom: 5px;
            font-size: 9px;
            font-weight: 700;
            letter-spacing: .9px;
            text-transform: uppercase;
            color: #888888;
        }

        .teachers-page .profile-fact-value {
            font-family: 'Times New Roman', serif;
            font-size: 19px;
            color: #111111;
        }

        .teachers-page .delete-warning {
            margin-bottom: 22px;
            padding: 16px 18px;
            border: 1px solid #e3caca;
            border-radius: 6px;
            background: #fbf5f5;
            color: #7e3c3c;
            font-size: 12px;
            line-height: 1.7;
        }

    @@media (max-width: 1050px) {
        .teachers-page .teachers-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 700px) {
        .teachers-page {
            padding-top: 35px;
        }

            .teachers-page .teachers-shell {
                width: 92%;
            }

            .teachers-page .teachers-head {
                align-items: flex-start;
                flex-direction: column;
            }

            .teachers-page .teachers-title {
                font-size: 35px;
            }

            .teachers-page .teachers-grid {
                grid-template-columns: 1fr;
            }

            .teachers-page .teacher-panel-body,
            .teachers-page .teacher-panel-head {
                padding-left: 22px;
                padding-right: 22px;
            }

            .teachers-page .profile-facts {
                grid-template-columns: 1fr;
            }
    }
</style>


<div class="teachers-page">
    <div class="teachers-shell">

        <div class="teachers-head">
            <div>
                <div class="teachers-kicker">Faculty Directory</div>
                <h1 class="teachers-title">Edit Teacher</h1>
                <p class="teachers-description">
                    Update the faculty member's information while keeping the same teacher record.
                </p>
            </div>
        </div>

        <div class="teacher-panel">
            <div class="teacher-panel-head">
                <div class="panel-kicker">Teacher #@Model.TeacherId</div>
                <h2>@Model.Name</h2>
                <p>Edit the stored teacher information below.</p>
            </div>

            <div class="teacher-panel-body">

                @using (Html.BeginForm())
                {
    @Html.AntiForgeryToken()

                    @Html.ValidationSummary(
                             true,
                             "",
                             new { @class = "text-danger" }
                         )

                                    @Html.HiddenFor(model => model.TeacherId)

                                                    <div class="teacher-form-group">
                                                        @Html.LabelFor(model => model.Name, new { @class = "teacher-form-label" })

                                                        @Html.EditorFor(
                                                                 model => model.Name,
                                                                 new
                                                                 {
                                                                     htmlAttributes = new
                                                                     {
                                                                         @class = "teacher-input",
                                                                         placeholder = "Enter teacher name"
                                                                     }
                                                                 }
                                                             )

                                                        @Html.ValidationMessageFor(
                                                                 model => model.Name,
                                                                 "",
                                                                 new { @class = "text-danger" }
                                                             )
                                                    </div>

                                                                    <div class="teacher-form-group">
                                                                        @Html.LabelFor(model => model.Subject, new { @class = "teacher-form-label" })

                                                                        @Html.EditorFor(
                                                                                 model => model.Subject,
                                                                                 new
                                                                                 {
                                                                                     htmlAttributes = new
                                                                                     {
                                                                                         @class = "teacher-input",
                                                                                         placeholder = "Enter subject"
                                                                                     }
                                                                                 }
                                                                             )

                                                                        @Html.ValidationMessageFor(
                                                                                 model => model.Subject,
                                                                                 "",
                                                                                 new { @class = "text-danger" }
                                                                             )
                                                                    </div>

                                                                                    <div class="teacher-form-actions">
                                                                                        <button type="submit"
                                                                                                class="teacher-btn teacher-btn-dark">
                                                                                            Save Changes
                                                                                        </button>

                                                                                        @Html.ActionLink(
                                                                                                 "View Details",
                                                                                                 "Details",
                                                                                                 "Teachers",
                                                                                                 new { id = Model.TeacherId },
                                                                                                 new { @class = "teacher-btn teacher-btn-light" }
                                                                                             )

                                                                                        @Html.ActionLink(
                                                                                                 "Back to Teachers",
                                                                                                 "Index",
                                                                                                 "Teachers",
                                                                                                 null,
                                                                                                 new { @class = "teacher-btn teacher-btn-light" }
                                                                                             )
                                                                                    </div>}

            </div>
        </div>

    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
