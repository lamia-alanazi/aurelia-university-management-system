                        <div class="teacher-details-item">
                            <span class="teacher-details-label">
                                Office
                            </span>

                            <span class="teacher-details-value"
                                  id="deleteTeacherOffice">
                            </span>
                        </div>

                        <div class="teacher-details-item">
                            <span class="teacher-details-label">
                                Teacher ID
                            </span>

                            <span class="teacher-details-value"
                                  id="deleteTeacherIdDisplay">
                            </span>
                        </div>

                    </div>


                    <div class="teacher-delete-warning">

                        <div class="teacher-delete-warning-title">
                            Warning
                        </div>

                        This teacher will be permanently deleted.
                        This action cannot be undone.

                    </div>


                    <div class="teacher-form-actions">

                        <button type="button"
                                class="teacher-cancel-button"
                                onclick="backFromTeacherDelete()">
                            Cancel
                        </button>

                        <button type="submit"
                                class="teacher-save-button">
                            Delete Teacher
                        </button>

                    </div>

                </div>}

</div>


<script>

    var isAdmin = @isAdmin.ToString().ToLower();

    var mainTeacherSubjects = [
        "Biology",
        "Business",
        "Computer Science",
        "Engineering",
        "Geography",
        "Mathematics"
    ];


    var teachersData = [

        @for (int i = 0; i < teachers.Count; i++)
        {
            var teacher = teachers[i];

            var assignedCourseText =
                string.Join(
                    "|",
                    assignedCourses
                        .Where(c => c.TeacherId == teacher.TeacherId)
                        .OrderBy(c => c.CourseCode)
                        .Select(c =>
                            (string.IsNullOrWhiteSpace(c.CourseCode)
                                ? ""
                                : c.CourseCode + " — ")
                            + (c.CourseName ?? "Course"))
                        .ToList()
                );

            <text>
            {
                id: @teacher.TeacherId,

                name:
                    '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(teacher.Name ?? ""))',

                subject:
                    '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(teacher.Subject ?? ""))',

                office:
                    '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(teacher.Office ?? ""))',

                title:
                    '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(teacher.Title ?? ""))',

                about:
                    '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(teacher.About ?? ""))',

                education:
                    '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(teacher.Education ?? ""))',

                academicExperience:
                    '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(teacher.AcademicExperience ?? ""))',

                researchInterests:
                    '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(teacher.ResearchInterests ?? ""))',

                coursesTaught:
                    '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(teacher.CoursesTaught ?? ""))',

                assignedCourses:
                    '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(assignedCourseText ?? ""))',

                email:
                    '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(teacher.Email ?? ""))',

                imagePath:
                    '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(teacher.ImagePath ?? ""))'

            }@(i < teachers.Count - 1 ? "," : "")
            </text>
        }

    ];


    var selectedTeacher = null;


    function isMainTeacherSubject(subject) {

        return mainTeacherSubjects.indexOf(subject) !== -1;
    }


    function getTeacherInitials(name) {

        if (!name) {
            return "";
        }

        var parts =
            name.trim().split(/\s+/);

        if (parts.length === 1) {
            return parts[0].charAt(0).toUpperCase();
        }

        return (
            parts[0].charAt(0) +
            parts[parts.length - 1].charAt(0)
        ).toUpperCase();
    }


    function setTeacherAvatar(
        containerId,
        name,
        imagePath
    ) {

        var container =
            document.getElementById(
                containerId
            );

        if (!container) {
            return;
        }


        container.innerHTML =
            "";


        if (
            imagePath &&
            imagePath.trim() !== ""
        ) {

            var image =
                document.createElement(
                    "img"
                );

            image.src =
                imagePath;

            image.alt =
                name || "Teacher";


            image.onerror =
                function () {

                    container.innerHTML =
                        "";

                    container.textContent =
                        getTeacherInitials(
                            name
                        );
                };


            container.appendChild(
                image
            );

            return;
        }


        container.textContent =
            getTeacherInitials(
                name
            );
    }


    function showTeacherOverlay() {

        document
            .getElementById("teacherOverlay")
            .classList
            .add("open");
    }


    function hideTeacherPanelsOnly() {

        var panels = [
            "teacherDetailsPanel",
            "fullTeacherDetailsPanel",
            "addTeacherPanel",
            "editTeacherPanel",
            "deleteTeacherPanel"
        ];

        for (var i = 0; i < panels.length; i++) {

            var panel =
                document.getElementById(panels[i]);

            if (panel) {
                panel.classList.remove("open");
            }
        }
    }


    function closeAllTeacherPanels() {

        hideTeacherPanelsOnly();

        document
            .getElementById("teacherOverlay")
            .classList
            .remove("open");
    }


    function fillTeacherOverview() {

        if (!selectedTeacher) {
            return;
        }

        setTeacherAvatar(
            "panelTeacherInitials",
            selectedTeacher.name,
            selectedTeacher.imagePath
        );

        document.getElementById("panelTeacherName").textContent =
            selectedTeacher.name || "Teacher";

        document.getElementById("panelTeacherTitle").textContent =
            selectedTeacher.title || "Faculty Member";

        document.getElementById("panelTeacherSubject").textContent =
            selectedTeacher.subject || "No subject assigned";

        document.getElementById("panelTeacherId").textContent =
            selectedTeacher.id;

        document.getElementById("panelTeacherSubjectBox").textContent =
            selectedTeacher.subject || "Not Assigned";

        document.getElementById("panelTeacherOffice").textContent =
            selectedTeacher.office || "Not Assigned";

        document.getElementById("panelTeacherPosition").textContent =
            selectedTeacher.title || "Faculty Member";
    }


    function openTeacherPanel(index) {

        var teacher =
            teachersData[index];

        if (!teacher) {
            return;
        }

        selectedTeacher =
            teacher;

        fillTeacherOverview();

        hideTeacherPanelsOnly();
        showTeacherOverlay();

        document
            .getElementById("teacherDetailsPanel")
            .classList
            .add("open");
    }


    function addListItems(containerId, value, emptyText) {

        var container =
            document.getElementById(containerId);

        container.innerHTML = "";


        if (!value || !value.trim()) {

            var empty =
                document.createElement("div");

            empty.className =
                "teacher-cv-list-item";

            empty.textContent =
                emptyText || "No information available.";

            container.appendChild(empty);

            return;
        }


        var values =
            value.split("|");


        for (var i = 0; i < values.length; i++) {

            if (!values[i].trim()) {
                continue;
            }

            var item =
                document.createElement("div");

            item.className =
                "teacher-cv-list-item";

            item.textContent =
                values[i].trim();

            container.appendChild(item);
        }
    }


    function addResearchTags(value) {

        var container =
            document.getElementById("fullTeacherResearch");

        container.innerHTML = "";


        if (!value || !value.trim()) {

            var tag =
                document.createElement("span");

            tag.className =
                "teacher-cv-tag";

            tag.textContent =
                "No research interests listed";

            container.appendChild(tag);

            return;
        }


        var values =
            value.split("|");


        for (var i = 0; i < values.length; i++) {

            if (!values[i].trim()) {
                continue;
            }

            var tag =
                document.createElement("span");

            tag.className =
                "teacher-cv-tag";

            tag.textContent =
                values[i].trim();

            container.appendChild(tag);
        }
    }


    function fillFullTeacherDetails() {

        if (!selectedTeacher) {
            return;
        }


        setTeacherAvatar(
            "fullTeacherInitials",
            selectedTeacher.name,
            selectedTeacher.imagePath
        );

        document.getElementById("fullTeacherName").textContent =
            selectedTeacher.name || "Teacher";

        document.getElementById("fullTeacherTitle").textContent =
            selectedTeacher.title || "Faculty Member";

        document.getElementById("fullTeacherSubject").textContent =
            selectedTeacher.subject || "";

        document.getElementById("fullTeacherAbout").textContent =
            selectedTeacher.about || "No biography has been added.";

        document.getElementById("fullTeacherOffice").textContent =
            selectedTeacher.office || "Not Assigned";

        document.getElementById("fullTeacherEmail").textContent =
            selectedTeacher.email || "Not Assigned";

        document.getElementById("fullTeacherSubjectBox").textContent =
            selectedTeacher.subject || "Not Assigned";

        document.getElementById("fullTeacherId").textContent =
            selectedTeacher.id;


        addListItems(
            "fullTeacherEducation",
            selectedTeacher.education
        );

        addListItems(
            "fullTeacherExperience",
            selectedTeacher.academicExperience
        );

        addListItems(
            "fullTeacherAssignedCourses",
            selectedTeacher.assignedCourses,
            "No courses currently assigned."
        );

        addListItems(
            "fullTeacherCourses",
            selectedTeacher.coursesTaught
        );

        addResearchTags(
            selectedTeacher.researchInterests
        );
    }


    function openFullTeacherDetailsPanel() {

        if (!selectedTeacher) {
            return;
        }

        fillFullTeacherDetails();

        hideTeacherPanelsOnly();
        showTeacherOverlay();

        document
            .getElementById("fullTeacherDetailsPanel")
            .classList
            .add("open");
    }


    function backFromFullTeacherDetails() {

        fillTeacherOverview();

        hideTeacherPanelsOnly();
        showTeacherOverlay();

        document
            .getElementById("teacherDetailsPanel")
            .classList
            .add("open");
    }


    /* Add subject handling */

    function updateAddTeacherSubject() {

        var select =
            document.getElementById("addTeacherSubjectSelect");

        var otherField =
            document.getElementById("addOtherSubjectField");

        var otherInput =
            document.getElementById("addOtherSubjectInput");

        var hiddenSubject =
            document.getElementById("addTeacherSubjectValue");


        if (select.value === "Other") {

            otherField.classList.add("open");
            otherInput.required = true;

            hiddenSubject.value =
                otherInput.value.trim();
        }
        else {

            otherField.classList.remove("open");
            otherInput.required = false;
            otherInput.value = "";

            hiddenSubject.value =
                select.value;
        }
    }


    function openAddTeacherPanel() {

        if (!isAdmin) {
            return;
        }

        selectedTeacher = null;

        var form =
            document.getElementById("addTeacherForm");

        if (form) {
            form.reset();
        }

        document.getElementById("addTeacherSubjectValue").value = "";
        document.getElementById("addOtherSubjectInput").value = "";

        updateAddTeacherSubject();

        hideTeacherPanelsOnly();
        showTeacherOverlay();

        document
            .getElementById("addTeacherPanel")
            .classList
            .add("open");
    }


    /* Edit subject handling */

    function updateEditTeacherSubject() {

        var select =
            document.getElementById("editTeacherSubjectSelect");

        var otherField =
            document.getElementById("editOtherSubjectField");

        var otherInput =
            document.getElementById("editOtherSubjectInput");

        var hiddenSubject =
            document.getElementById("editTeacherSubjectValue");


        if (select.value === "Other") {

            otherField.classList.add("open");
            otherInput.required = true;

            hiddenSubject.value =
                otherInput.value.trim();
        }
        else {

            otherField.classList.remove("open");
            otherInput.required = false;
            otherInput.value = "";

            hiddenSubject.value =
                select.value;
        }
    }


    function openEditTeacherPanel() {

        if (!isAdmin) {
            return;
        }

        if (!selectedTeacher) {
            return;
        }


        document.getElementById("editTeacherId").value =
            selectedTeacher.id;

        document.getElementById("editTeacherName").value =
            selectedTeacher.name || "";

        document.getElementById("editTeacherTitle").value =
            selectedTeacher.title || "";


        var editSubject =
            selectedTeacher.subject || "";


        if (isMainTeacherSubject(editSubject)) {

            document.getElementById("editTeacherSubjectSelect").value =
                editSubject;

            document.getElementById("editOtherSubjectInput").value =
                "";
        }
        else {

            document.getElementById("editTeacherSubjectSelect").value =
                "Other";

            document.getElementById("editOtherSubjectInput").value =
                editSubject;
        }


        updateEditTeacherSubject();


        if (
            document.getElementById("editTeacherSubjectSelect").value === "Other"
        ) {

            document.getElementById("editOtherSubjectInput").value =
                editSubject;

            document.getElementById("editTeacherSubjectValue").value =
                editSubject;
        }


        document.getElementById("editTeacherOffice").value =
            selectedTeacher.office || "";

        document.getElementById("editTeacherEmail").value =
            selectedTeacher.email || "";

        document.getElementById("editTeacherAbout").value =
            selectedTeacher.about || "";

        document.getElementById("editTeacherEducation").value =
            selectedTeacher.education || "";

        document.getElementById("editTeacherExperience").value =
            selectedTeacher.academicExperience || "";

        document.getElementById("editTeacherResearch").value =
            selectedTeacher.researchInterests || "";

        document.getElementById("editTeacherCourses").value =
            selectedTeacher.coursesTaught || "";

        document.getElementById("editTeacherImagePath").value =
            selectedTeacher.imagePath || "";


        hideTeacherPanelsOnly();
        showTeacherOverlay();

        document
            .getElementById("editTeacherPanel")
            .classList
            .add("open");
    }


    function backToTeacherDetails() {

        if (!selectedTeacher) {
            closeAllTeacherPanels();
            return;
        }

        fillTeacherOverview();

        hideTeacherPanelsOnly();
        showTeacherOverlay();

        document
            .getElementById("teacherDetailsPanel")
            .classList
            .add("open");
    }


    function openDeleteTeacherPanel() {

        if (!isAdmin) {
            return;
        }

        if (!selectedTeacher) {
            return;
        }


        document.getElementById("deleteTeacherId").value =
            selectedTeacher.id;

        document.getElementById("deleteTeacherName").textContent =
            selectedTeacher.name || "";

        document.getElementById("deleteTeacherSubject").textContent =
            selectedTeacher.subject || "Not Assigned";

        document.getElementById("deleteTeacherOffice").textContent =
            selectedTeacher.office || "Not Assigned";

        document.getElementById("deleteTeacherIdDisplay").textContent =
            selectedTeacher.id;


        hideTeacherPanelsOnly();
        showTeacherOverlay();

        document
            .getElementById("deleteTeacherPanel")
            .classList
            .add("open");
    }


    function backFromTeacherDelete() {

        backToTeacherDetails();
    }


    /* Subject events */

    document
        .getElementById("addTeacherSubjectSelect")
        .addEventListener(
            "change",
            updateAddTeacherSubject
        );


    document
        .getElementById("addOtherSubjectInput")
        .addEventListener(
            "input",
            updateAddTeacherSubject
        );


    document
        .getElementById("editTeacherSubjectSelect")
        .addEventListener(
            "change",
            updateEditTeacherSubject
        );


    document
        .getElementById("editOtherSubjectInput")
        .addEventListener(
            "input",
            updateEditTeacherSubject
        );


    document
        .getElementById("addTeacherForm")
        .addEventListener(
            "submit",
            function (event) {

                updateAddTeacherSubject();

                var subject =
                    document
                        .getElementById("addTeacherSubjectValue")
                        .value
                        .trim();

                if (!subject) {

                    event.preventDefault();

                    document
                        .getElementById("addTeacherSubjectSelect")
                        .focus();
                }
            }
        );


    document
        .getElementById("editTeacherForm")
        .addEventListener(
            "submit",
            function (event) {

                updateEditTeacherSubject();

                var subject =
                    document
                        .getElementById("editTeacherSubjectValue")
                        .value
                        .trim();

                if (!subject) {

                    event.preventDefault();

                    document
                        .getElementById("editTeacherSubjectSelect")
                        .focus();
                }
            }
        );


    /* Filter menu and checkbox filtering */

    (function () {

        var wrap =
            document.getElementById("teacherFilterWrap");

        var button =
            document.getElementById("teacherFilterButton");

        var menu =
            document.getElementById("teacherFilterMenu");

        var clearButton =
            document.getElementById("teacherFilterClear");

        var allCheckbox =
            document.getElementById("teacherFilterAll");

        var countBadge =
            document.getElementById("teacherFilterCount");

        var checkboxes =
            document.querySelectorAll(".teacher-filter-checkbox");

        var cards =
            document.querySelectorAll(".teacher-card");


        function openFilterMenu() {

            menu.classList.add("open");
            button.classList.add("open");
            button.setAttribute("aria-expanded", "true");
        }


        function closeFilterMenu() {

            menu.classList.remove("open");
            button.classList.remove("open");
            button.setAttribute("aria-expanded", "false");
        }


        function getSelectedSubjects() {

            var selected = [];

            for (var i = 0; i < checkboxes.length; i++) {

                if (
                    checkboxes[i].value !== "All" &&
                    checkboxes[i].checked
                ) {

                    selected.push(
                        checkboxes[i].value
                    );
                }
            }

            return selected;
        }


        function updateFilterBadge(selected) {

            if (
                allCheckbox.checked ||
                selected.length === 0
            ) {

                countBadge.classList.remove("show");
                countBadge.textContent = "";

                return;
            }


            countBadge.textContent =
                selected.length;

            countBadge.classList.add("show");
        }


        function applyTeacherFilters() {

            var selected =
                getSelectedSubjects();


            if (
                !allCheckbox.checked &&
                selected.length === 0
            ) {

                allCheckbox.checked =
                    true;
            }


            if (allCheckbox.checked) {

                for (var a = 0; a < cards.length; a++) {

                    cards[a].style.display =
                        "";
                }

                updateFilterBadge([]);

                return;
            }


            for (var c = 0; c < cards.length; c++) {

                var subject =
                    cards[c].getAttribute(
                        "data-subject"
                    );


                cards[c].style.display =
                    selected.indexOf(subject) !== -1
                        ? ""
                        : "none";
            }


            updateFilterBadge(selected);
        }


        button.addEventListener(
            "click",
            function (event) {

                event.stopPropagation();


                if (
                    menu.classList.contains("open")
                ) {

                    closeFilterMenu();
                }
                else {

                    openFilterMenu();
                }
            }
        );


        menu.addEventListener(
            "click",
            function (event) {

                event.stopPropagation();
            }
        );


        allCheckbox.addEventListener(
            "change",
            function () {

                if (this.checked) {

                    for (
                        var i = 0;
                        i < checkboxes.length;
                        i++
                    ) {

                        if (
                            checkboxes[i].value !== "All"
                        ) {

                            checkboxes[i].checked =
                                false;
                        }
                    }
                }

                applyTeacherFilters();
            }
        );


        for (
            var i = 0;
            i < checkboxes.length;
            i++
        ) {

            if (
                checkboxes[i].value === "All"
            ) {

                continue;
            }


            checkboxes[i].addEventListener(
                "change",
                function () {

                    if (this.checked) {

                        allCheckbox.checked =
                            false;
                    }


                    var selected =
                        getSelectedSubjects();


                    if (selected.length === 0) {

                        allCheckbox.checked =
                            true;
                    }


                    applyTeacherFilters();
                }
            );
        }


        clearButton.addEventListener(
            "click",
            function () {

                for (
                    var i = 0;
                    i < checkboxes.length;
                    i++
                ) {

                    checkboxes[i].checked =
                        checkboxes[i].value === "All";
                }


                applyTeacherFilters();
            }
        );


        document.addEventListener(
            "click",
            function (event) {

                if (
                    wrap &&
                    !wrap.contains(event.target)
                ) {

                    closeFilterMenu();
                }
            }
        );


        applyTeacherFilters();

    })();


    document.addEventListener(
        "keydown",
        function (event) {

            if (event.key === "Escape") {

                var filterMenu =
                    document.getElementById("teacherFilterMenu");

                var filterButton =
                    document.getElementById("teacherFilterButton");


                if (
                    filterMenu &&
                    filterMenu.classList.contains("open")
                ) {

                    filterMenu.classList.remove("open");

                    if (filterButton) {
                        filterButton.classList.remove("open");
                        filterButton.setAttribute("aria-expanded", "false");
                    }

                    return;
                }


                closeAllTeacherPanels();
            }
        }
    );

</script>
