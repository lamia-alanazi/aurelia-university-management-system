@model IEnumerable<lamia12771.Models.Teacher>
@using System
@using System.Collections.Generic
@using System.Linq

@{ ViewBag.Title = "Teachers";

    var teachers = Model == null
        ? new List<lamia12771.Models.Teacher>()
        : Model.ToList();

    var assignedCourses =
        ViewBag.AssignedCourses as List<lamia12771.Models.Course>
        ?? new List<lamia12771.Models.Course>();

    var subjects = teachers
        .Where(t => !string.IsNullOrWhiteSpace(t.Subject))
        .Select(t => t.Subject.Trim())
        .Distinct()
        .OrderBy(s => s)
        .ToList();

    var mainSubjects = new[]
    {
        "Biology",
        "Business",
        "Computer Science",
        "Engineering",
        "Geography",
        "Mathematics"
    };

    bool isAdmin =
        Session["IsAdmin"] != null
        && Session["IsAdmin"] is bool
        && (bool)Session["IsAdmin"]; }

<style>

    /* Teachers page styles */

    .teachers-page {
        width: 100%;
        min-height: 100vh;
        padding: 70px 0 90px;
        background: #ffffff;
        color: #171717;
        font-family: Arial, sans-serif;
    }

        .teachers-page * {
            box-sizing: border-box;
        }

    .teachers-container {
        width: 88%;
        max-width: 1380px;
        margin: 0 auto;
    }


    /* Header section */

    .teachers-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 40px;
        padding-bottom: 32px;
        border-bottom: 1px solid #e1e3e4;
    }

    .teachers-heading-small {
        margin-bottom: 10px;
        color: #3E4348;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    .teachers-header h1 {
        margin: 0;
        font-family: 'Times New Roman', serif;
        font-size: 48px;
        font-weight: 400;
        color: #171717;
    }

    .teachers-header p {
        max-width: 500px;
        margin: 12px 0 0;
        font-size: 12px;
        line-height: 1.8;
        color: #777777;
    }


    /* Summary area */

    .teachers-summary {
        display: flex;
        align-items: center;
        gap: 35px;
    }

    .teacher-summary-item {
        min-width: 85px;
    }

    .teacher-summary-number {
        display: block;
        font-family: 'Times New Roman', serif;
        font-size: 32px;
        line-height: 1;
        color: #171717;
    }

    .teacher-summary-label {
        display: block;
        margin-top: 7px;
        font-size: 9px;
        letter-spacing: .8px;
        text-transform: uppercase;
        color: #888888;
    }


    /* Toolbar section */

    .teachers-toolbar {
        margin: 34px 0 32px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 25px;
    }

    .teacher-filter-wrap {
        position: relative;
        display: inline-flex;
        align-items: center;
    }

    .teacher-filter-trigger {
        position: relative;
        width: 44px;
        height: 44px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #d8dadd;
        border-radius: 8px;
        background: #ffffff;
        color: #3E4348;
        cursor: pointer;
        transition: .25s ease;
    }

        .teacher-filter-trigger:hover,
        .teacher-filter-trigger.open {
            border-color: #3E4348;
            background: #f4f4f3;
        }

        .teacher-filter-trigger svg {
            width: 21px;
            height: 21px;
            display: block;
        }

    .teacher-filter-count {
        position: absolute;
        top: -6px;
        right: -6px;
        min-width: 18px;
        height: 18px;
        padding: 0 5px;
        display: none;
        align-items: center;
        justify-content: center;
        border: 2px solid #ffffff;
        border-radius: 20px;
        background: #3E4348;
        color: #ffffff;
        font-size: 8px;
        font-weight: 700;
        line-height: 1;
    }

        .teacher-filter-count.show {
            display: inline-flex;
        }

    .teacher-filter-menu {
        position: absolute;
        top: calc(100% + 10px);
        left: 0;
        z-index: 200;
        width: 255px;
        max-width: calc(100vw - 40px);
        padding: 15px;
        border: 1px solid #d7dadd;
        border-radius: 10px;
        background: #ffffff;
        box-shadow: 0 18px 45px rgba(32,36,40,.14);
        opacity: 0;
        visibility: hidden;
        transform: translateY(-5px);
        transition: .2s ease;
    }

        .teacher-filter-menu.open {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

    .teacher-filter-menu-head {
        margin-bottom: 10px;
        padding-bottom: 10px;
        border-bottom: 1px solid #eceeef;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .teacher-filter-menu-title {
        color: #3E4348;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 1.2px;
        text-transform: uppercase;
    }

    .teacher-filter-clear {
        padding: 0;
        border: 0;
        background: transparent;
        color: #777777;
        font-size: 9px;
        text-transform: uppercase;
        cursor: pointer;
    }

        .teacher-filter-clear:hover {
            color: #3E4348;
        }

    .teacher-filter-option {
        min-height: 36px;
        display: flex;
        align-items: center;
        gap: 10px;
        cursor: pointer;
        color: #44494d;
        font-size: 11px;
        user-select: none;
    }

        .teacher-filter-option + .teacher-filter-option {
            border-top: 1px solid #f0f1f1;
        }

        .teacher-filter-option input {
            position: absolute;
            opacity: 0;
            pointer-events: none;
        }

    .teacher-filter-check {
        width: 16px;
        height: 16px;
        flex: 0 0 16px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #bfc3c5;
        border-radius: 3px;
        background: #ffffff;
        transition: .2s ease;
    }

    .teacher-filter-option input:checked + .teacher-filter-check {
        border-color: #3E4348;
        background: #3E4348;
    }

        .teacher-filter-option input:checked + .teacher-filter-check:after {
            content: "";
            width: 7px;
            height: 4px;
            border-left: 2px solid #ffffff;
            border-bottom: 2px solid #ffffff;
            transform: rotate(-45deg) translateY(-1px);
        }

    .teacher-filter-option input:focus + .teacher-filter-check {
        box-shadow: 0 0 0 2px rgba(62,67,72,.12);
    }

    .teacher-filter-option-text {
        flex: 1;
        min-width: 0;
    }


    /* Add button styles */

    .add-teacher-button {
        display: inline-block;
        padding: 11px 20px;
        background: #3E4348;
        border: 1px solid #3E4348;
        color: #ffffff;
        font-size: 10px;
        letter-spacing: .7px;
        text-transform: uppercase;
        text-decoration: none;
        cursor: pointer;
        transition: .25s ease;
    }

        .add-teacher-button:hover,
        .add-teacher-button:focus {
            background: #2F3438;
            border-color: #2F3438;
            color: #ffffff;
        }


    /* Teacher cards */

    .teachers-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 25px;
    }

    .teacher-card {
        position: relative;
        min-height: 205px;
        padding: 20px;
        overflow: hidden;
        background: #ffffff;
        border: 1px solid #e1e3e4;
        border-radius: 8px;
        box-shadow: 0 8px 24px rgba(32,36,40,.05);
        cursor: pointer;
        transition: transform .3s ease, box-shadow .3s ease, border-color .3s ease;
    }

        .teacher-card:hover {
            transform: translateY(-5px);
            border-color: #737A80;
            box-shadow: 0 18px 45px rgba(32,36,40,.11);
        }

    .teacher-card-top {
        display: flex;
        gap: 16px;
        align-items: flex-start;
    }

    .teacher-avatar {
        width: 76px;
        height: 94px;
        flex: 0 0 76px;
        border: 1px solid #d1d4d6;
        border-radius: 7px;
        overflow: hidden;
        background: #eeeeec;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .teacher-avatar img,
        .teacher-panel-avatar img,
        .teacher-cv-avatar img {
            width: 100%;
            height: 100%;
            display: block;
            object-fit: cover;
            object-position: center top;
            transform: scale(1.12);
            transform-origin: center top;
        }


    .teacher-avatar-fallback {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .teacher-card-info {
        flex: 1;
        min-width: 0;
    }

    .teacher-name {
        margin: 0 0 4px;
        font-family: 'Times New Roman', serif;
        font-size: 20px;
        font-weight: 400;
        color: #171717;
    }

    .teacher-role {
        margin-bottom: 4px;
        color: #3E4348;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .4px;
        text-transform: uppercase;
    }

    .teacher-subject {
        color: #888888;
        font-size: 11px;
        line-height: 1.5;
    }

    .teacher-facts {
        margin-top: 13px;
        padding-top: 12px;
        display: flex;
        gap: 35px;
        border-top: 1px solid #eceeef;
    }

    .teacher-fact-value {
        display: block;
        margin-bottom: 3px;
        font-family: 'Times New Roman', serif;
        font-size: 17px;
        color: #171717;
    }

    .teacher-fact-label {
        display: block;
        font-size: 8px;
        letter-spacing: .8px;
        text-transform: uppercase;
        color: #999999;
    }

    .teacher-card-footer {
        margin-top: 17px;
        padding-top: 14px;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        border-top: 1px solid #eceeef;
    }

    .teacher-view-text {
        color: #3E4348;
        font-size: 9px;
        font-weight: 600;
        letter-spacing: .8px;
        text-transform: uppercase;
    }

    .teachers-empty {
        grid-column: 1 / -1;
        padding: 70px 20px;
        text-align: center;
        border: 1px solid #e1e3e4;
        color: #777777;
    }


    /* Popup overlay */

    .teacher-overlay {
        position: fixed;
        inset: 0;
        z-index: 9998;
        background: rgba(10,11,13,.64);
        backdrop-filter: blur(2px);
        opacity: 0;
        visibility: hidden;
        transition: opacity .3s ease;
    }

        .teacher-overlay.open {
            opacity: 1;
            visibility: visible;
        }


    /* Popup panels */

    .teacher-details-panel,
    .teacher-form-panel,
    .teacher-delete-panel,
    .teacher-full-panel {
        position: fixed;
        top: 50%;
        left: 50%;
        z-index: 9999;
        max-width: 92%;
        max-height: 90vh;
        overflow-y: auto;
        overflow-x: hidden;
        background: #ffffff;
        color: #202326;
        border: 1px solid #c8cbcd;
        border-radius: 18px;
        box-shadow: 0 30px 90px rgba(0,0,0,.28);
        opacity: 0;
        visibility: hidden;
        transform: translate(-50%, -47%) scale(.97);
        transition: opacity .28s ease, transform .32s ease, visibility .28s ease;
    }

    .teacher-details-panel,
    .teacher-form-panel,
    .teacher-delete-panel {
        width: 610px;
    }

    .teacher-full-panel {
        width: 790px;
    }

        .teacher-details-panel.open,
        .teacher-form-panel.open,
        .teacher-delete-panel.open,
        .teacher-full-panel.open {
            opacity: 1;
            visibility: visible;
            transform: translate(-50%, -50%) scale(1);
        }


    /* Header section */

    .teacher-panel-header {
        position: relative;
        padding: 28px 30px 23px;
        background: #ffffff;
        border-bottom: 1px solid #d1d4d6;
    }

    .teacher-panel-small {
        margin-bottom: 7px;
        color: #646a6e;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
    }

    .teacher-panel-header h2 {
        margin: 0;
        padding-right: 60px;
        font-family: 'Times New Roman', serif;
        font-size: 31px;
        font-weight: 400;
        color: #171717;
    }

    .teacher-panel-header p {
        max-width: 470px;
        margin: 7px 0 0;
        color: #6f7579;
        font-size: 11px;
        line-height: 1.7;
    }

    .teacher-panel-close {
        position: absolute;
        right: 25px;
        top: 27px;
        width: 42px;
        height: 42px;
        border: 1px solid #3E4348;
        border-radius: 50%;
        background: #3E4348;
        color: #ffffff;
        font-size: 21px;
        cursor: pointer;
    }


    /* Overview content */

    .teacher-panel-body {
        padding: 27px 30px 32px;
        background: #ffffff;
    }

    .teacher-profile-top {
        display: flex;
        align-items: center;
        gap: 18px;
        padding-bottom: 23px;
        border-bottom: 1px solid #d5d7d9;
    }

    .teacher-panel-avatar {
        width: 78px;
        height: 92px;
        flex: 0 0 78px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #d1d4d6;
        border-radius: 9px;
        background: #eeeeec;
        color: #3E4348;
        font-family: 'Times New Roman', serif;
        font-size: 26px;
    }

    .teacher-profile-name {
        margin: 0;
        font-family: 'Times New Roman', serif;
        font-size: 25px;
        font-weight: 400;
    }

    .teacher-profile-role {
        margin-top: 5px;
        color: #3E4348;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .teacher-profile-subject {
        margin-top: 5px;
        color: #777777;
        font-size: 12px;
    }

    .teacher-details-list {
        margin-top: 24px;
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
    }

    .teacher-details-item {
        padding: 16px;
        background: #eeeeec;
        border: 1px solid #d1d4d6;
        border-radius: 10px;
    }

    .teacher-details-label {
        display: block;
        margin-bottom: 7px;
        color: #666c70;
        font-size: 8px;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .teacher-details-value {
        display: block;
        color: #202326;
        font-size: 13px;
        line-height: 1.7;
    }


    /* Action buttons */

    .teacher-panel-actions {
        margin-top: 28px;
        padding-top: 20px;
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        border-top: 1px solid #d5d7d9;
    }

    .teacher-panel-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 11px 17px;
        border: 1px solid #c5c8ca;
        background: #ffffff;
        color: #3f4447;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: .8px;
        text-transform: uppercase;
        cursor: pointer;
        transition: .2s ease;
    }

        .teacher-panel-action:hover {
            border-color: #3E4348;
            color: #3E4348;
        }

        .teacher-panel-action.edit {
            background: #3E4348;
            border-color: #3E4348;
            color: #ffffff;
        }

            .teacher-panel-action.edit:hover {
                background: #2F3438;
                border-color: #2F3438;
                color: #ffffff;
            }


    /* Full CV section */

    .teacher-cv-hero {
        position: relative;
        min-height: 205px;
        padding: 34px;
        display: flex;
        align-items: center;
        gap: 24px;
        background: #3E4348;
        color: #ffffff;
    }

    .teacher-cv-close {
        position: absolute;
        right: 24px;
        top: 22px;
        width: 42px;
        height: 42px;
        border: 1px solid rgba(255,255,255,.3);
        border-radius: 50%;
        background: rgba(255,255,255,.08);
        color: #ffffff;
        font-size: 21px;
        cursor: pointer;
    }

    .teacher-cv-avatar {
        width: 118px;
        height: 138px;
        flex: 0 0 118px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(255,255,255,.3);
        border-radius: 10px;
        background: #eeeeec;
        color: #3E4348;
        font-family: 'Times New Roman', serif;
        font-size: 34px;
        overflow: hidden;
    }

    .teacher-cv-heading {
        padding-right: 45px;
    }

    .teacher-cv-kicker {
        margin-bottom: 9px;
        color: rgba(255,255,255,.65);
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 1.7px;
        text-transform: uppercase;
    }

    .teacher-cv-name {
        margin: 0;
        font-family: 'Times New Roman', serif;
        font-size: 34px;
        font-weight: 400;
        color: #ffffff;
    }

    .teacher-cv-title {
        margin-top: 9px;
        font-size: 12px;
        font-weight: 700;
    }

    .teacher-cv-subject {
        margin-top: 5px;
        color: rgba(255,255,255,.72);
        font-size: 11px;
    }

    .teacher-cv-body {
        padding: 30px 34px 34px;
    }

    .teacher-cv-section {
        padding-bottom: 24px;
        margin-bottom: 24px;
        border-bottom: 1px solid #e0e2e3;
    }

    .teacher-cv-section-title {
        margin-bottom: 12px;
        color: #3E4348;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 1.4px;
        text-transform: uppercase;
    }

    .teacher-cv-about {
        margin: 0;
        color: #4f5559;
        font-size: 13px;
        line-height: 1.9;
    }

    .teacher-cv-list {
        display: flex;
        flex-direction: column;
        gap: 9px;
    }

    .teacher-cv-list-item {
        padding: 12px 14px;
        border: 1px solid #d9dcde;
        border-radius: 8px;
        background: #f4f4f3;
        color: #34393d;
        font-size: 12px;
        line-height: 1.65;
    }

    .teacher-cv-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .teacher-cv-tag {
        padding: 8px 11px;
        border: 1px solid #d1d4d6;
        border-radius: 7px;
        background: #eeeeec;
        color: #303438;
        font-size: 9px;
        font-weight: 600;
    }

    .teacher-cv-contact-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
    }

    .teacher-cv-contact-item {
        padding: 15px;
        background: #eeeeec;
        border: 1px solid #d1d4d6;
        border-radius: 10px;
    }

    .teacher-cv-contact-label {
        display: block;
        margin-bottom: 7px;
        color: #666c70;
        font-size: 8px;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .teacher-cv-contact-value {
        font-size: 12px;
        color: #202326;
    }


    /* Form styles */

    .teacher-form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 17px;
    }

    .teacher-form-field {
        display: flex;
        flex-direction: column;
        gap: 7px;
    }

        .teacher-form-field.full {
            grid-column: 1 / -1;
        }

        .teacher-form-field label {
            color: #555b5f;
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

    .teacher-input,
    .teacher-textarea {
        width: 100%;
        border: 1px solid #c9ccce;
        border-radius: 8px;
        background: #eeeeec;
        color: #202326;
        font-family: Arial, sans-serif;
        font-size: 12px;
    }

    .teacher-input {
        height: 46px;
        padding: 0 13px;
    }

    .teacher-textarea {
        min-height: 90px;
        padding: 12px 13px;
        resize: vertical;
    }

    .teacher-form-help {
        font-size: 8px;
        color: #777777;
    }

    .teacher-other-subject {
        display: none;
    }

        .teacher-other-subject.open {
            display: flex;
        }

    .teacher-form-actions {
        margin-top: 25px;
        padding-top: 20px;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        border-top: 1px solid #d1d4d6;
    }

    .teacher-cancel-button,
    .teacher-save-button {
        min-width: 115px;
        padding: 11px 18px;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: .8px;
        text-transform: uppercase;
        cursor: pointer;
    }

    .teacher-cancel-button {
        border: 1px solid #bfc3c5;
        background: #ffffff;
    }

    .teacher-save-button {
        border: 1px solid #3E4348;
        background: #3E4348;
        color: #ffffff;
    }

    #deleteTeacherPanel .teacher-save-button {
        background: #b74a4a;
        border-color: #b74a4a;
    }

    .teacher-delete-warning {
        margin-top: 20px;
        padding: 17px;
        background: #f4f4f3;
        border: 1px solid #d7d9db;
        border-radius: 9px;
    }

    .teacher-delete-warning-title {
        margin-bottom: 8px;
        color: #8a3d3d;
        font-size: 9px;
        font-weight: 700;
        text-transform: uppercase;
    }


    @@media (max-width: 1050px) {
        .teachers-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 768px) {
        .teachers-container {
            width: 92%;
        }

        .teachers-header {
            flex-direction: column;
        }

        .teachers-toolbar {
            flex-direction: column;
            align-items: flex-start;
        }

        .teachers-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 560px) {
        .teacher-details-list,
        .teacher-form-grid,
