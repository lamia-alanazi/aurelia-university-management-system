@model IEnumerable<lamia12771.Models.Student>
@using System
@using System.Collections.Generic
@using System.Linq

@{ ViewBag.Title = "Students";

    var students =
        Model == null
            ? new List<lamia12771.Models.Student>()
            : Model.ToList();

    var teachers =
        ViewBag.Teachers as List<lamia12771.Models.Teacher>
        ?? new List<lamia12771.Models.Teacher>();

    var majors =
        students
            .Where(s => !string.IsNullOrWhiteSpace(s.Major))
            .Select(s => s.Major.Trim())
            .Distinct()
            .OrderBy(s => s)
            .ToList();

    var mainMajors = new[]
    {
        "Software Engineering",
        "Computer Science",
        "Biology",
        "Business Administration",
        "Mechanical Engineering"
    };

    decimal averageGpa =
        students.Count == 0
            ? 0
            : students.Average(s => s.GPA);


    bool isAdmin =
        Session["IsAdmin"] != null
        && Session["IsAdmin"] is bool
        && (bool)Session["IsAdmin"]; }

<style>
    /* STUDENTS PAGE Same Aurelia scale and layout language as Teachers */

    .students-page {
        width: 100%;
        min-height: 100vh;
        padding: 70px 0 90px;
        background: #ffffff;
        color: #171717;
        font-family: Arial, sans-serif;
    }

        .students-page * {
            box-sizing: border-box;
        }

    .students-container {
        width: 88%;
        max-width: 1380px;
        margin: 0 auto;
    }


    /* HEADER */

    .students-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 40px;
        padding-bottom: 32px;
        border-bottom: 1px solid #e1e3e4;
    }

    .students-heading-small {
        margin-bottom: 10px;
        color: #3E4348;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    .students-header h1 {
        margin: 0;
        font-family: 'Times New Roman', serif;
        font-size: 48px;
        font-weight: 400;
        color: #171717;
    }

    .students-header p {
        max-width: 520px;
        margin: 12px 0 0;
        font-size: 12px;
        line-height: 1.8;
        color: #777777;
    }

    .students-summary {
        display: flex;
        align-items: center;
        gap: 35px;
    }

    .student-summary-item {
        min-width: 90px;
    }

    .student-summary-number {
        display: block;
        font-family: 'Times New Roman', serif;
        font-size: 32px;
        line-height: 1;
        color: #171717;
    }

    .student-summary-label {
        display: block;
        margin-top: 7px;
        font-size: 9px;
        letter-spacing: .8px;
        text-transform: uppercase;
        color: #888888;
    }


    /* TOOLBAR / FILTER */

    .students-toolbar {
        margin: 34px 0 32px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 25px;
    }

    .student-filter-wrap {
        position: relative;
        display: inline-flex;
        align-items: center;
    }

    .student-filter-trigger {
        position: relative;
        width: 44px;
        height: 44px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #d8dadd;
        border-radius: 8px;
        background: #ffffff;
        color: #3E4348;
        cursor: pointer;
        transition: .25s ease;
    }

        .student-filter-trigger:hover,
        .student-filter-trigger.open {
            border-color: #3E4348;
            background: #f4f4f3;
        }

        .student-filter-trigger svg {
            width: 21px;
            height: 21px;
            display: block;
        }

    .student-filter-count {
        position: absolute;
        top: -6px;
        right: -6px;
        min-width: 18px;
        height: 18px;
        padding: 0 5px;
        display: none;
        align-items: center;
        justify-content: center;
        border: 2px solid #ffffff;
        border-radius: 20px;
        background: #3E4348;
        color: #ffffff;
        font-size: 8px;
        font-weight: 700;
        line-height: 1;
    }

        .student-filter-count.show {
            display: inline-flex;
        }

    .student-filter-menu {
        position: absolute;
        top: calc(100% + 10px);
        left: 0;
        z-index: 200;
        width: 285px;
        max-width: calc(100vw - 40px);
        padding: 15px;
        border: 1px solid #d7dadd;
        border-radius: 10px;
        background: #ffffff;
        box-shadow: 0 18px 45px rgba(32,36,40,.14);
        opacity: 0;
        visibility: hidden;
        transform: translateY(-5px);
        transition: .2s ease;
    }

        .student-filter-menu.open {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

    .student-filter-menu-head {
        margin-bottom: 10px;
        padding-bottom: 10px;
        border-bottom: 1px solid #eceeef;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .student-filter-menu-title {
        color: #3E4348;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 1.2px;
        text-transform: uppercase;
    }

    .student-filter-clear {
        padding: 0;
        border: 0;
        background: transparent;
        color: #777777;
        font-size: 9px;
        text-transform: uppercase;
        cursor: pointer;
    }

        .student-filter-clear:hover {
            color: #3E4348;
        }

    .student-filter-option {
        min-height: 36px;
        display: flex;
        align-items: center;
        gap: 10px;
        cursor: pointer;
        color: #44494d;
        font-size: 11px;
        user-select: none;
    }

        .student-filter-option + .student-filter-option {
            border-top: 1px solid #f0f1f1;
        }

        .student-filter-option input {
            position: absolute;
            opacity: 0;
            pointer-events: none;
        }

    .student-filter-check {
        width: 16px;
        height: 16px;
        flex: 0 0 16px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #bfc3c5;
        border-radius: 3px;
        background: #ffffff;
        transition: .2s ease;
    }

    .student-filter-option input:checked + .student-filter-check {
        border-color: #3E4348;
        background: #3E4348;
    }

        .student-filter-option input:checked + .student-filter-check:after {
            content: "";
            width: 7px;
            height: 4px;
            border-left: 2px solid #ffffff;
            border-bottom: 2px solid #ffffff;
            transform: rotate(-45deg) translateY(-1px);
        }

    .student-filter-option-text {
        flex: 1;
        min-width: 0;
    }

    .add-student-button {
        display: inline-block;
        padding: 11px 20px;
        background: #3E4348;
        border: 1px solid #3E4348;
        color: #ffffff;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .7px;
        text-transform: uppercase;
        text-decoration: none;
        cursor: pointer;
        transition: .25s ease;
    }

        .add-student-button:hover {
            background: #2F3438;
            border-color: #2F3438;
        }


    /* STUDENT CARDS */

    .students-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 25px;
    }

    .student-card {
        position: relative;
        min-height: 300px;
        padding: 20px;
        overflow: hidden;
        background: #ffffff;
        border: 1px solid #e1e3e4;
        border-radius: 8px;
        box-shadow: 0 8px 24px rgba(32,36,40,.05);
        cursor: pointer;
        transition: transform .3s ease, box-shadow .3s ease, border-color .3s ease;
    }

        .student-card:hover {
            transform: translateY(-5px);
            border-color: #737A80;
            box-shadow: 0 18px 45px rgba(32,36,40,.11);
        }

    .student-card-top {
        display: flex;
        gap: 16px;
        align-items: flex-start;
    }

    .student-avatar {
        width: 100px;
        height: 118px;
        flex: 0 0 100px;
        border: 1px solid #d1d4d6;
        border-radius: 8px;
        overflow: hidden;
        background: #eeeeec;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #3E4348;
        font-family: 'Times New Roman', serif;
        font-size: 25px;
    }

        .student-avatar img,
        .student-panel-avatar img,
        .student-full-avatar img {
            width: 100%;
            height: 100%;
            display: block;
            object-fit: cover;
            object-position: center top;
        }

    .student-card-info {
        flex: 1;
        min-width: 0;
    }

    .student-name {
        margin: 0 0 4px;
        font-family: 'Times New Roman', serif;
        font-size: 20px;
        font-weight: 400;
        color: #171717;
    }

    .student-major {
        margin-bottom: 4px;
        color: #3E4348;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .4px;
        text-transform: uppercase;
    }

    .student-level {
        color: #888888;
        font-size: 11px;
        line-height: 1.5;
    }

    .student-stats {
        margin-top: 13px;
        padding-top: 12px;
        display: flex;
        gap: 24px;
        border-top: 1px solid #eceeef;
    }

    .student-stat-value {
        display: block;
        margin-bottom: 3px;
        font-family: 'Times New Roman', serif;
        font-size: 17px;
        color: #171717;
    }

    .student-stat-label {
        display: block;
        font-size: 8px;
        letter-spacing: .8px;
        text-transform: uppercase;
        color: #999999;
    }

    .student-progress {
        margin-top: 16px;
    }

    .student-progress-head {
        margin-bottom: 6px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        color: #777777;
        font-size: 8px;
        font-weight: 700;
        letter-spacing: .7px;
        text-transform: uppercase;
    }

    .student-progress-track {
        width: 100%;
        height: 5px;
        overflow: hidden;
        border-radius: 20px;
        background: #eceeef;
    }

    .student-progress-fill {
        height: 100%;
        border-radius: 20px;
        background: #3E4348;
    }

    .student-advisor-line {
        margin-top: 14px;
        padding-top: 12px;
        border-top: 1px solid #eceeef;
        color: #777777;
        font-size: 10px;
        line-height: 1.6;
    }

    .student-advisor-label {
        display: block;
        margin-bottom: 2px;
        color: #999999;
        font-size: 8px;
        font-weight: 700;
        letter-spacing: .8px;
        text-transform: uppercase;
    }

    .student-advisor-name {
        color: #34393d;
        font-weight: 600;
    }

    .student-card-footer {
        margin-top: 14px;
        padding-top: 12px;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        border-top: 1px solid #eceeef;
    }

    .student-view-text {
        color: #3E4348;
        font-size: 9px;
        font-weight: 600;
        letter-spacing: .8px;
        text-transform: uppercase;
    }

    .students-empty {
        grid-column: 1 / -1;
        padding: 70px 20px;
        text-align: center;
        border: 1px solid #e1e3e4;
        color: #777777;
    }


    /* OVERLAY / PANELS */

    .student-overlay {
        position: fixed;
        inset: 0;
        z-index: 9998;
        background: rgba(10,11,13,.64);
        backdrop-filter: blur(2px);
        opacity: 0;
        visibility: hidden;
        transition: opacity .3s ease;
    }

        .student-overlay.open {
            opacity: 1;
            visibility: visible;
        }

    .student-details-panel,
    .student-form-panel,
    .student-delete-panel,
    .student-full-panel {
        position: fixed;
        top: 50%;
        left: 50%;
        z-index: 9999;
        max-width: 92%;
        max-height: 90vh;
        overflow-y: auto;
        overflow-x: hidden;
        background: #ffffff;
        color: #202326;
        border: 1px solid #c8cbcd;
        border-radius: 18px;
        box-shadow: 0 30px 90px rgba(0,0,0,.28);
        opacity: 0;
        visibility: hidden;
        transform: translate(-50%, -47%) scale(.97);
        transition: opacity .28s ease, transform .32s ease, visibility .28s ease;
    }

    .student-details-panel,
    .student-form-panel {
        width: 700px;
    }

    .student-delete-panel {
        width: 540px;
    }

    .student-full-panel {
        width: 790px;
    }

        .student-details-panel.open,
        .student-form-panel.open,
        .student-delete-panel.open,
        .student-full-panel.open {
            opacity: 1;
            visibility: visible;
            transform: translate(-50%, -50%) scale(1);
        }

    .student-panel-header {
        position: relative;
        padding: 28px 30px 23px;
        background: #ffffff;
        border-bottom: 1px solid #d1d4d6;
    }

    .student-panel-small {
        margin-bottom: 7px;
        color: #646a6e;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
    }

    .student-panel-header h2 {
        margin: 0;
        padding-right: 60px;
        font-family: 'Times New Roman', serif;
        font-size: 31px;
        font-weight: 400;
        color: #171717;
    }

    .student-panel-header p {
        max-width: 520px;
        margin: 7px 0 0;
        color: #6f7579;
        font-size: 11px;
        line-height: 1.7;
    }

    .student-panel-close {
        position: absolute;
        right: 25px;
        top: 27px;
        width: 42px;
        height: 42px;
        border: 1px solid #3E4348;
        border-radius: 50%;
        background: #3E4348;
        color: #ffffff;
        font-size: 21px;
        cursor: pointer;
    }

    .student-panel-body {
        padding: 27px 30px 32px;
        background: #ffffff;
    }

    .student-profile-top {
        display: flex;
        align-items: center;
        gap: 18px;
        padding-bottom: 23px;
        border-bottom: 1px solid #d5d7d9;
    }

    .student-panel-avatar {
        width: 78px;
        height: 92px;
        flex: 0 0 78px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        border: 1px solid #d1d4d6;
        border-radius: 9px;
        background: #eeeeec;
        color: #3E4348;
        font-family: 'Times New Roman', serif;
        font-size: 26px;
    }

    .student-profile-name {
        margin: 0;
        font-family: 'Times New Roman', serif;
        font-size: 25px;
        font-weight: 400;
    }

    .student-profile-major {
        margin-top: 5px;
        color: #3E4348;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .student-profile-level {
        margin-top: 5px;
        color: #777777;
        font-size: 12px;
    }

    .student-details-list {
        margin-top: 24px;
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
    }

    .student-details-item {
        padding: 16px;
        background: #eeeeec;
        border: 1px solid #d1d4d6;
        border-radius: 10px;
    }

        .student-details-item.full {
            grid-column: 1 / -1;
        }

    .student-details-label {
        display: block;
        margin-bottom: 7px;
        color: #666c70;
        font-size: 8px;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .student-details-value {
        display: block;
        color: #202326;
        font-size: 13px;
        line-height: 1.7;
        word-break: break-word;
    }

    .student-panel-actions {
        margin-top: 28px;
        padding-top: 20px;
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        border-top: 1px solid #d5d7d9;
    }

    .student-panel-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 11px 17px;
        border: 1px solid #c5c8ca;
        background: #ffffff;
        color: #3f4447;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: .8px;
        text-transform: uppercase;
        cursor: pointer;
        transition: .2s ease;
    }

        .student-panel-action:hover {
            border-color: #3E4348;
            color: #3E4348;
        }

        .student-panel-action.edit {
            background: #3E4348;
            border-color: #3E4348;
            color: #ffffff;
        }

            .student-panel-action.edit:hover {
                background: #2F3438;
                border-color: #2F3438;
            }


    /* FULL DETAILS */

    .student-full-hero {
        position: relative;
        min-height: 205px;
        padding: 34px;
        display: flex;
        align-items: center;
        gap: 24px;
        background: #3E4348;
        color: #ffffff;
    }

    .student-full-close {
        position: absolute;
        right: 24px;
        top: 22px;
        width: 42px;
        height: 42px;
        border: 1px solid rgba(255,255,255,.3);
        border-radius: 50%;
        background: rgba(255,255,255,.08);
        color: #ffffff;
        font-size: 21px;
        cursor: pointer;
    }

    .student-full-avatar {
        width: 118px;
        height: 138px;
        flex: 0 0 118px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,.3);
        border-radius: 10px;
        background: #eeeeec;
        color: #3E4348;
        font-family: 'Times New Roman', serif;
        font-size: 34px;
    }

    .student-full-heading {
        padding-right: 45px;
    }

    .student-full-kicker {
        margin-bottom: 9px;
        color: rgba(255,255,255,.65);
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 1.7px;
        text-transform: uppercase;
    }

    .student-full-name {
        margin: 0;
        font-family: 'Times New Roman', serif;
        font-size: 34px;
        font-weight: 400;
        color: #ffffff;
    }

    .student-full-major {
        margin-top: 9px;
        font-size: 12px;
        font-weight: 700;
    }

    .student-full-level {
        margin-top: 5px;
        color: rgba(255,255,255,.72);
        font-size: 11px;
    }

    .student-full-body {
        padding: 30px 34px 34px;
    }

    .student-full-section {
        padding-bottom: 24px;
        margin-bottom: 24px;
        border-bottom: 1px solid #e0e2e3;
    }

    .student-full-section-title {
        margin-bottom: 12px;
        color: #3E4348;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 1.4px;
        text-transform: uppercase;
    }

    .student-facts-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
    }

    .student-fact-box {
        padding: 15px;
        border: 1px solid #d9dcde;
        border-radius: 8px;
        background: #f4f4f3;
    }

    .student-fact-number {
        display: block;
        font-family: 'Times New Roman', serif;
        font-size: 21px;
        color: #171717;
    }

    .student-fact-caption {
        display: block;
        margin-top: 5px;
        color: #777777;
        font-size: 8px;
        font-weight: 700;
        letter-spacing: .8px;
        text-transform: uppercase;
    }

    .student-advisor-box {
        padding: 18px;
        border: 1px solid #d9dcde;
        border-radius: 9px;
        background: #f4f4f3;
    }

    .student-advisor-box-name {
        margin-bottom: 5px;
        font-family: 'Times New Roman', serif;
        font-size: 19px;
        color: #171717;
    }

    .student-advisor-box-meta {
        color: #6f7579;
        font-size: 11px;
        line-height: 1.7;
    }

    .student-contact-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
    }

    .student-contact-item {
        padding: 15px;
        background: #eeeeec;
        border: 1px solid #d1d4d6;
        border-radius: 10px;
    }

    .student-contact-label {
        display: block;
        margin-bottom: 7px;
        color: #666c70;
        font-size: 8px;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .student-contact-value {
        color: #202326;
        font-size: 12px;
        word-break: break-word;
    }


    /* FORMS */

    .student-form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 17px;
    }

    .student-form-field {
        display: flex;
        flex-direction: column;
        gap: 7px;
    }

        .student-form-field.full {
            grid-column: 1 / -1;
        }

        .student-form-field label {
            color: #555b5f;
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

    .student-input {
        width: 100%;
        height: 46px;
        padding: 0 13px;
        border: 1px solid #c9ccce;
        border-radius: 8px;
        background: #eeeeec;
        color: #202326;
        font-family: Arial, sans-serif;
        font-size: 12px;
        outline: none;
    }

        .student-input:focus {
            border-color: #3E4348;
            background: #f4f4f3;
            box-shadow: 0 0 0 2px rgba(62,67,72,.08);
        }

    .student-other-major {
        display: none;
    }

        .student-other-major.open {
            display: flex;
        }

    .student-form-help {
        font-size: 8px;
        color: #777777;
        line-height: 1.5;
    }

    .student-form-actions {
        margin-top: 25px;
        padding-top: 20px;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        border-top: 1px solid #d1d4d6;
    }

    .student-cancel-button,
    .student-save-button {
        min-width: 115px;
        padding: 11px 18px;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: .8px;
        text-transform: uppercase;
        cursor: pointer;
    }

    .student-cancel-button {
        border: 1px solid #bfc3c5;
        background: #ffffff;
        color: #3f4447;
    }

    .student-save-button {
        border: 1px solid #3E4348;
        background: #3E4348;
        color: #ffffff;
    }

    #deleteStudentPanel .student-save-button {
        background: #b74a4a;
        border-color: #b74a4a;
    }

    .student-delete-warning {
        margin-top: 20px;
        padding: 17px;
        background: #f4f4f3;
        border: 1px solid #d7d9db;
        border-radius: 9px;
        color: #555b5f;
        font-size: 12px;
