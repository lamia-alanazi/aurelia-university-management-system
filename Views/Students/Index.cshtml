                <div class="student-form-field">
                    <label>Degree Progress</label>

                    <input type="number"
                           name="DegreeProgress"
                           id="editStudentProgress"
                           class="student-input"
                           min="0"
                           max="100"
                           required />
                </div>


                <!-- ACADEMIC STANDING + EMAIL -->

                <div class="student-form-field">
                    <label>Academic Standing (Optional)</label>

                    <input name="AcademicStanding"
                           id="editStudentStanding"
                           class="student-input" />
                </div>


                <div class="student-form-field">
                    <label>Email</label>

                    <input type="email"
                           name="Email"
                           id="editStudentEmail"
                           class="student-input"
                           required />
                </div>


                <!-- ACADEMIC ADVISOR + IMAGE PATH -->

                <div class="student-form-field">

                    <label>
                        Academic Advisor (Optional)
                    </label>

                    <select name="TeacherId"
                            id="editStudentTeacherId"
                            class="student-input">

                        <option value="">
                            Not Assigned
                        </option>

                        @foreach (var teacher in teachers)
                        {
                            <option value="@teacher.TeacherId">
                                @teacher.Name — @teacher.Subject
                            </option>
                        }

                    </select>

                </div>


                <div class="student-form-field">

                    <label>
                        Image Path (Optional)
                    </label>

                    <input name="ImagePath"
                           id="editStudentImagePath"
                           class="student-input" />

                </div>

            </div>


            <div class="student-form-actions">

                <button type="button"
                        class="student-cancel-button"
                        onclick="backToStudentDetails()">
                    Cancel
                </button>

                <button type="submit"
                        class="student-save-button">
                    Save Changes
                </button>

            </div>

        </div>
    }

</div>


<!-- =========================================================
     DELETE STUDENT
     ========================================================= -->
<div class="student-delete-panel"
     id="deleteStudentPanel">

    <div class="student-panel-header">
        <div class="student-panel-small">
            Student Management
        </div>

        <h2>Delete Student</h2>

        <p>
            Please confirm that you want to permanently remove this student.
        </p>

        <button type="button"
                class="student-panel-close"
                onclick="backFromStudentDelete()">
            ×
        </button>
    </div>


    @using (Html.BeginForm(
        "Delete",
        "Students",
        FormMethod.Post))
    {
@Html.AntiForgeryToken()

                <div class="student-panel-body">

                    <input type="hidden"
                           name="id"
                           id="deleteStudentId" />

                    <div class="student-delete-warning">
                        <div class="student-delete-warning-title">
                            Delete Confirmation
                        </div>

                        <strong id="deleteStudentName"></strong>
                        <br />
                        <span id="deleteStudentMajor"></span>

                        <br /><br />

                        This student will be permanently deleted.
                        This action cannot be undone.
                    </div>


                    <div class="student-form-actions">
                        <button type="button"
                                class="student-cancel-button"
                                onclick="backFromStudentDelete()">
                            Cancel
                        </button>

                        <button type="submit"
                                class="student-save-button">
                            Delete Student
                        </button>
                    </div>
                </div>}
</div>


<script>
    var studentAdminAccess = @(isAdmin ? "true" : "false");

    var mainStudentMajors = [
        "Software Engineering",
        "Computer Science",
        "Biology",
        "Business Administration",
        "Mechanical Engineering"
    ];


    var studentsData = [
        @for (int i = 0; i < students.Count; i++)
        {
            var student = students[i];

            var advisorName =
                student.Teacher == null
                    ? ""
                    : student.Teacher.Name;

            var advisorSubject =
                student.Teacher == null
                    ? ""
                    : student.Teacher.Subject;

            var advisorEmail =
                student.Teacher == null
                    ? ""
                    : student.Teacher.Email;

            <text>
            {
                id: @student.StudentId,

                name:
                    '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(student.Name ?? ""))',

                age: @student.Age,

                major:
                    '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(student.Major ?? ""))',

                level:
                    '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(student.Level ?? ""))',

                gpa:
                    '@student.GPA.ToString(System.Globalization.CultureInfo.InvariantCulture)',

                credits: @student.CreditsCompleted,

                progress: @student.DegreeProgress,

                standing:
                    '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(student.AcademicStanding ?? ""))',

                email:
                    '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(student.Email ?? ""))',

                imagePath:
                    '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(student.ImagePath ?? ""))',

                teacherId:
                    '@(student.TeacherId.HasValue ? student.TeacherId.Value.ToString() : "")',

                advisorName:
                    '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(advisorName ?? ""))',

                advisorSubject:
                    '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(advisorSubject ?? ""))',

                advisorEmail:
                    '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(advisorEmail ?? ""))'
            }@(i < students.Count - 1 ? "," : "")
            </text>
        }
    ];


    var selectedStudent = null;


    function isMainStudentMajor(major) {
        return mainStudentMajors.indexOf(major) !== -1;
    }


    function getStudentInitials(name) {
        if (!name) {
            return "";
        }

        var parts =
            name.trim().split(/\s+/);

        if (parts.length === 1) {
            return parts[0].charAt(0).toUpperCase();
        }

        return (
            parts[0].charAt(0) +
            parts[parts.length - 1].charAt(0)
        ).toUpperCase();
    }


    function setStudentAvatar(
        containerId,
        name,
        imagePath
    ) {
        var container =
            document.getElementById(containerId);

        if (!container) {
            return;
        }

        container.innerHTML = "";

        if (
            imagePath &&
            imagePath.trim() !== ""
        ) {
            var image =
                document.createElement("img");

            image.src = imagePath;
            image.alt = name || "Student";

            image.onerror =
                function () {
                    container.innerHTML = "";
                    container.textContent =
                        getStudentInitials(name);
                };

            container.appendChild(image);
            return;
        }

        container.textContent =
            getStudentInitials(name);
    }


    function hideStudentPanelsOnly() {
        var panels = [
            "studentDetailsPanel",
            "fullStudentDetailsPanel",
            "addStudentPanel",
            "editStudentPanel",
            "deleteStudentPanel"
        ];

        for (var i = 0; i < panels.length; i++) {
            document
                .getElementById(panels[i])
                .classList
                .remove("open");
        }
    }


    function showStudentOverlay() {
        document
            .getElementById("studentOverlay")
            .classList
            .add("open");
    }


    function closeAllStudentPanels() {
        selectedStudent = null;

        hideStudentPanelsOnly();

        document
            .getElementById("studentOverlay")
            .classList
            .remove("open");
    }


    function normalizedProgress(value) {
        var progress =
            parseInt(value || 0, 10);

        if (progress < 0) {
            progress = 0;
        }

        if (progress > 100) {
            progress = 100;
        }

        return progress;
    }


    function fillStudentOverview() {
        if (!selectedStudent) {
            return;
        }

        setStudentAvatar(
            "panelStudentInitials",
            selectedStudent.name,
            selectedStudent.imagePath
        );

        document.getElementById("panelStudentName").textContent =
            selectedStudent.name || "Student";

        document.getElementById("panelStudentMajor").textContent =
            selectedStudent.major || "Not Assigned";

        document.getElementById("panelStudentLevel").textContent =
            selectedStudent.level || "Level Not Assigned";

        document.getElementById("panelStudentId").textContent =
            selectedStudent.id;

        document.getElementById("panelStudentAge").textContent =
            selectedStudent.age || "—";

        document.getElementById("panelStudentGpa").textContent =
            selectedStudent.gpa || "0.00";

        document.getElementById("panelStudentCredits").textContent =
            selectedStudent.credits || 0;

        document.getElementById("panelStudentStanding").textContent =
            selectedStudent.standing || "Not Assigned";

        document.getElementById("panelStudentProgress").textContent =
            normalizedProgress(selectedStudent.progress) + "%";

        document.getElementById("panelStudentAdvisor").textContent =
            selectedStudent.advisorName || "Not Assigned";

        document.getElementById("panelStudentEmail").textContent =
            selectedStudent.email || "Not Assigned";
    }


    function openStudentPanel(index) {
        var student =
            studentsData[index];

        if (!student) {
            return;
        }

        selectedStudent = student;

        fillStudentOverview();

        hideStudentPanelsOnly();
        showStudentOverlay();

        document
            .getElementById("studentDetailsPanel")
            .classList
            .add("open");
    }


    function fillFullStudentDetails() {
        if (!selectedStudent) {
            return;
        }

        var progress =
            normalizedProgress(
                selectedStudent.progress
            );

        setStudentAvatar(
            "fullStudentInitials",
            selectedStudent.name,
            selectedStudent.imagePath
        );

        document.getElementById("fullStudentName").textContent =
            selectedStudent.name || "Student";

        document.getElementById("fullStudentMajor").textContent =
            selectedStudent.major || "Not Assigned";

        document.getElementById("fullStudentLevel").textContent =
            selectedStudent.level || "Level Not Assigned";

        document.getElementById("fullStudentGpa").textContent =
            selectedStudent.gpa || "0.00";

        document.getElementById("fullStudentCredits").textContent =
            selectedStudent.credits || 0;

        document.getElementById("fullStudentId").textContent =
            selectedStudent.id;

        document.getElementById("fullStudentAge").textContent =
            selectedStudent.age || "—";

        document.getElementById("fullStudentStanding").textContent =
            selectedStudent.standing || "Not Assigned";

        document.getElementById("fullStudentProgressNumber").textContent =
            progress + "%";

        document.getElementById("fullStudentProgressText").textContent =
            progress + "%";

        document.getElementById("fullStudentProgressBar").style.width =
            progress + "%";

        document.getElementById("fullStudentAdvisorName").textContent =
            selectedStudent.advisorName || "Not Assigned";

        document.getElementById("fullStudentAdvisorSubject").textContent =
            selectedStudent.advisorSubject
                ? "Subject: " + selectedStudent.advisorSubject
                : "No advisor subject available";

        document.getElementById("fullStudentAdvisorEmail").textContent =
            selectedStudent.advisorEmail
                ? "Email: " + selectedStudent.advisorEmail
                : "No advisor email available";

        document.getElementById("fullStudentEmail").textContent =
            selectedStudent.email || "Not Assigned";

        document.getElementById("fullStudentMajorBox").textContent =
            selectedStudent.major || "Not Assigned";

        document.getElementById("fullStudentLevelBox").textContent =
            selectedStudent.level || "Not Assigned";

        document.getElementById("fullStudentStandingBox").textContent =
            selectedStudent.standing || "Not Assigned";
    }


    function openFullStudentDetailsPanel() {
        if (!selectedStudent) {
            return;
        }

        fillFullStudentDetails();

        hideStudentPanelsOnly();
        showStudentOverlay();

        document
            .getElementById("fullStudentDetailsPanel")
            .classList
            .add("open");
    }


    function backFromFullStudentDetails() {
        fillStudentOverview();

        hideStudentPanelsOnly();
        showStudentOverlay();

        document
            .getElementById("studentDetailsPanel")
            .classList
            .add("open");
    }


    /* ADD MAJOR */

    function updateAddStudentMajor() {
        var select =
            document.getElementById("addStudentMajorSelect");

        var otherField =
            document.getElementById("addOtherMajorField");

        var otherInput =
            document.getElementById("addOtherMajorInput");

        var hiddenMajor =
            document.getElementById("addStudentMajorValue");

        if (select.value === "Other") {
            otherField.classList.add("open");
            otherInput.required = true;

            hiddenMajor.value =
                otherInput.value.trim();
        }
        else {
            otherField.classList.remove("open");
            otherInput.required = false;
            otherInput.value = "";

            hiddenMajor.value =
                select.value;
        }
    }


    function openAddStudentPanel() {
        if (!studentAdminAccess) {
            return;
        }

        selectedStudent = null;

        var form =
            document.getElementById("addStudentForm");

        if (form) {
            form.reset();
        }

        document.getElementById("addStudentMajorValue").value = "";
        document.getElementById("addOtherMajorInput").value = "";

        updateAddStudentMajor();

        hideStudentPanelsOnly();
        showStudentOverlay();

        document
            .getElementById("addStudentPanel")
            .classList
            .add("open");
    }


    /* EDIT MAJOR */

    function updateEditStudentMajor() {
        var select =
            document.getElementById("editStudentMajorSelect");

        var otherField =
            document.getElementById("editOtherMajorField");

        var otherInput =
            document.getElementById("editOtherMajorInput");

        var hiddenMajor =
            document.getElementById("editStudentMajorValue");

        if (select.value === "Other") {
            otherField.classList.add("open");
            otherInput.required = true;

            hiddenMajor.value =
                otherInput.value.trim();
        }
        else {
            otherField.classList.remove("open");
            otherInput.required = false;
            otherInput.value = "";

            hiddenMajor.value =
                select.value;
        }
    }


    function openEditStudentPanel() {
        if (!studentAdminAccess) {
            return;
        }

        if (!selectedStudent) {
            return;
        }

        document.getElementById("editStudentId").value =
            selectedStudent.id;

        document.getElementById("editStudentName").value =
            selectedStudent.name || "";

        document.getElementById("editStudentAge").value =
            selectedStudent.age || "";

        document.getElementById("editStudentLevel").value =
            selectedStudent.level || "";

        var editMajor =
            selectedStudent.major || "";

        if (isMainStudentMajor(editMajor)) {
            document.getElementById("editStudentMajorSelect").value =
                editMajor;

            document.getElementById("editOtherMajorInput").value =
                "";
        }
        else {
            document.getElementById("editStudentMajorSelect").value =
                "Other";

            document.getElementById("editOtherMajorInput").value =
                editMajor;
        }

        updateEditStudentMajor();

        if (
            document.getElementById("editStudentMajorSelect").value === "Other"
        ) {
            document.getElementById("editOtherMajorInput").value =
                editMajor;

            document.getElementById("editStudentMajorValue").value =
                editMajor;
        }

        document.getElementById("editStudentGpa").value =
            selectedStudent.gpa || "0";

        document.getElementById("editStudentCredits").value =
            selectedStudent.credits || 0;

        document.getElementById("editStudentProgress").value =
            normalizedProgress(selectedStudent.progress);

        document.getElementById("editStudentStanding").value =
            selectedStudent.standing || "";

        document.getElementById("editStudentEmail").value =
            selectedStudent.email || "";

        document.getElementById("editStudentTeacherId").value =
            selectedStudent.teacherId || "";

        document.getElementById("editStudentImagePath").value =
            selectedStudent.imagePath || "";

        hideStudentPanelsOnly();
        showStudentOverlay();

        document
            .getElementById("editStudentPanel")
            .classList
            .add("open");
    }


    function backToStudentDetails() {
        if (!selectedStudent) {
            closeAllStudentPanels();
            return;
        }

        fillStudentOverview();

        hideStudentPanelsOnly();
        showStudentOverlay();

        document
            .getElementById("studentDetailsPanel")
            .classList
            .add("open");
    }


    /* DELETE */

    function openDeleteStudentPanel() {
        if (!studentAdminAccess) {
            return;
        }

        if (!selectedStudent) {
            return;
        }

        document.getElementById("deleteStudentId").value =
            selectedStudent.id;

        document.getElementById("deleteStudentName").textContent =
            selectedStudent.name || "Student";

        document.getElementById("deleteStudentMajor").textContent =
            selectedStudent.major || "Not Assigned";

        hideStudentPanelsOnly();
        showStudentOverlay();

        document
            .getElementById("deleteStudentPanel")
            .classList
            .add("open");
    }


    function backFromStudentDelete() {
        backToStudentDetails();
    }


    /* MAJOR EVENTS */

    document
        .getElementById("addStudentMajorSelect")
        .addEventListener(
            "change",
            updateAddStudentMajor
        );

    document
        .getElementById("addOtherMajorInput")
        .addEventListener(
            "input",
            updateAddStudentMajor
        );

    document
        .getElementById("editStudentMajorSelect")
        .addEventListener(
            "change",
            updateEditStudentMajor
        );

    document
        .getElementById("editOtherMajorInput")
        .addEventListener(
            "input",
            updateEditStudentMajor
        );


    document
        .getElementById("addStudentForm")
        .addEventListener(
            "submit",
            function (event) {
                updateAddStudentMajor();

                var major =
                    document
                        .getElementById("addStudentMajorValue")
                        .value
                        .trim();

                if (!major) {
                    event.preventDefault();

                    document
                        .getElementById("addStudentMajorSelect")
                        .focus();
                }
            }
        );


    document
        .getElementById("editStudentForm")
        .addEventListener(
            "submit",
            function (event) {
                updateEditStudentMajor();

                var major =
                    document
                        .getElementById("editStudentMajorValue")
                        .value
                        .trim();

                if (!major) {
                    event.preventDefault();

                    document
                        .getElementById("editStudentMajorSelect")
                        .focus();
                }
            }
        );


    /* FILTER MENU + MULTI CHECKBOX FILTERING */

    (function () {
        var wrap =
            document.getElementById("studentFilterWrap");

        var button =
            document.getElementById("studentFilterButton");

        var menu =
            document.getElementById("studentFilterMenu");

        var clearButton =
            document.getElementById("studentFilterClear");

        var allCheckbox =
            document.getElementById("studentFilterAll");

        var countBadge =
            document.getElementById("studentFilterCount");

        var checkboxes =
            document.querySelectorAll(
                ".student-filter-checkbox"
            );

        var cards =
            document.querySelectorAll(
                ".student-card"
            );


        function openFilterMenu() {
            menu.classList.add("open");
            button.classList.add("open");
            button.setAttribute(
                "aria-expanded",
                "true"
            );
        }


        function closeFilterMenu() {
            menu.classList.remove("open");
            button.classList.remove("open");
            button.setAttribute(
                "aria-expanded",
                "false"
            );
        }


        function getSelectedMajors() {
            var selected = [];

            for (var i = 0; i < checkboxes.length; i++) {
                if (
                    checkboxes[i].value !== "All" &&
                    checkboxes[i].checked
                ) {
                    selected.push(
                        checkboxes[i].value
                    );
                }
            }

            return selected;
        }


        function updateFilterBadge(selected) {
            if (
                allCheckbox.checked ||
                selected.length === 0
            ) {
                countBadge.classList.remove("show");
                countBadge.textContent = "";
                return;
            }

            countBadge.textContent =
                selected.length;

            countBadge.classList.add("show");
        }


        function applyFilters() {
            var selected =
                getSelectedMajors();

            if (
                allCheckbox.checked ||
                selected.length === 0
            ) {
                for (var i = 0; i < cards.length; i++) {
                    cards[i].style.display = "";
                }

                updateFilterBadge([]);
                return;
            }

            for (var c = 0; c < cards.length; c++) {
                var major =
                    cards[c].getAttribute(
                        "data-major"
                    );

                cards[c].style.display =
                    selected.indexOf(major) !== -1
                        ? ""
                        : "none";
            }

            updateFilterBadge(selected);
        }


        button.addEventListener(
            "click",
            function (event) {
                event.stopPropagation();

                if (
                    menu.classList.contains("open")
                ) {
                    closeFilterMenu();
                }
                else {
                    openFilterMenu();
                }
            }
        );


        for (var i = 0; i < checkboxes.length; i++) {
            checkboxes[i].addEventListener(
                "change",
                function () {
                    if (this.value === "All") {
                        if (this.checked) {
                            for (
                                var j = 0;
                                j < checkboxes.length;
                                j++
                            ) {
                                if (
                                    checkboxes[j].value !== "All"
                                ) {
                                    checkboxes[j].checked = false;
                                }
                            }
                        }
                    }
                    else if (this.checked) {
                        allCheckbox.checked = false;
                    }

                    var selected =
                        getSelectedMajors();

                    if (selected.length === 0) {
                        allCheckbox.checked = true;
                    }

                    applyFilters();
                }
            );
        }


        clearButton.addEventListener(
            "click",
            function () {
                for (
                    var i = 0;
                    i < checkboxes.length;
                    i++
                ) {
                    checkboxes[i].checked =
                        checkboxes[i].value === "All";
                }

                applyFilters();
            }
        );


        document.addEventListener(
            "click",
            function (event) {
                if (
                    wrap &&
                    !wrap.contains(event.target)
                ) {
                    closeFilterMenu();
                }
            }
        );


        applyFilters();
    })();


    document.addEventListener(
        "keydown",
        function (event) {
            if (event.key === "Escape") {
                closeAllStudentPanels();
            }

        }

    );
</script>
