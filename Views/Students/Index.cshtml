<div class="students-page">
    <div class="students-container">

        <!-- HEADER -->
        <div class="students-header">
            <div>
                <div class="students-heading-small">
                    Student Directory
                </div>

                <h1>Students</h1>

                <p>
                    Browse enrolled students, their academic progress,
                    and assigned academic advisors.
                </p>
            </div>

            <div class="students-summary">
                <div class="student-summary-item">
                    <span class="student-summary-number">
                        @students.Count
                    </span>

                    <span class="student-summary-label">
                        Students Listed
                    </span>
                </div>

                <div class="student-summary-item">
                    <span class="student-summary-number">
                        @averageGpa.ToString("0.0")
                    </span>

                    <span class="student-summary-label">
                        Avg. GPA
                    </span>
                </div>

                <div class="student-summary-item">
                    <span class="student-summary-number">
                        @majors.Count
                    </span>

                    <span class="student-summary-label">
                        Majors
                    </span>
                </div>
            </div>
        </div>


        <!-- TOOLBAR -->
        <div class="students-toolbar">
            <div class="student-filter-wrap"
                 id="studentFilterWrap">

                <button type="button"
                        class="student-filter-trigger"
                        id="studentFilterButton"
                        aria-label="Filter students by major"
                        aria-expanded="false"
                        aria-controls="studentFilterMenu">

                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M4 5h16l-6.3 7.1v5.2l-3.4 1.8v-7L4 5z"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="1.8"
                              stroke-linejoin="round" />
                        <path d="M16.5 8.5h3.5M15.5 12h4.5M17 15.5h3"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="1.8"
                              stroke-linecap="round" />
                    </svg>

                    <span class="student-filter-count"
                          id="studentFilterCount">
                    </span>
                </button>


                <div class="student-filter-menu"
                     id="studentFilterMenu">

                    <div class="student-filter-menu-head">
                        <span class="student-filter-menu-title">
                            Filter by Major
                        </span>

                        <button type="button"
                                class="student-filter-clear"
                                id="studentFilterClear">
                            Clear
                        </button>
                    </div>


                    <label class="student-filter-option">
                        <input type="checkbox"
                               class="student-filter-checkbox"
                               value="All"
                               id="studentFilterAll"
                               checked />
                        <span class="student-filter-check"></span>
                        <span class="student-filter-option-text">All Majors</span>
                    </label>

                    @foreach (var major in mainMajors)
                    {
        <label class="student-filter-option">
            <input type="checkbox"
                   class="student-filter-checkbox"
                   value="@major" />
            <span class="student-filter-check"></span>
            <span class="student-filter-option-text">@major</span>
        </label>}

                    <label class="student-filter-option">
                        <input type="checkbox"
                               class="student-filter-checkbox"
                               value="Other" />
                        <span class="student-filter-check"></span>
                        <span class="student-filter-option-text">Other</span>
                    </label>
                </div>
            </div>


            @if (isAdmin)
            {
<button type="button"
        class="add-student-button"
        onclick="openAddStudentPanel()">
    Add New Student
</button>   }
        </div>


        <!-- GRID -->
        <div class="students-grid">
            @if (students.Count == 0)
            {
<div class="students-empty">
    No students have been added yet.
</div> }
else
{
for (int i = 0; i < students.Count; i++)
{
    var item = students[i];

    var initials = "";
    if (!string.IsNullOrWhiteSpace(item.Name))
    {
        var parts =
            item.Name.Split(
                new[] { ' ' },
                StringSplitOptions.RemoveEmptyEntries
            );

        initials =
            parts.Length == 1
                ? parts[0].Substring(0, 1)
                : parts[0].Substring(0, 1)
                  + parts[parts.Length - 1].Substring(0, 1);
    }

    var currentMajor =
        (item.Major ?? "").Trim();

    var filterMajor =
        mainMajors.Contains(currentMajor)
            ? currentMajor
            : "Other";

    var advisorName =
        item.Teacher == null
            ? "Not Assigned"
            : item.Teacher.Name;

    var progress =
        item.DegreeProgress < 0
            ? 0
            : item.DegreeProgress > 100
                ? 100
                : item.DegreeProgress;

<article class="student-card"
         data-major="@filterMajor"
         onclick="openStudentPanel(@i)">

    <div class="student-card-top">

        <div class="student-avatar">
            @if (!string.IsNullOrWhiteSpace(item.ImagePath))
            {
<img src="@item.ImagePath"
     alt="@item.Name"
     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />

                        <span style="display:none;">
                            @initials
                        </span> }
                    else
                    {
<span>@initials</span>}
        </div>


        <div class="student-card-info">
            <h3 class="student-name">
                @item.Name
            </h3>

            <div class="student-major">
                @(string.IsNullOrWhiteSpace(item.Major)
                                        ? "Not Assigned"
                                        : item.Major)
            </div>

            <div class="student-level">
                @(string.IsNullOrWhiteSpace(item.Level)
                                        ? "Level Not Assigned"
                                        : item.Level)
            </div>

            <div class="student-stats">
                <div>
                    <span class="student-stat-value">
                        @item.GPA.ToString("0.00")
                    </span>
                    <span class="student-stat-label">
                        GPA
                    </span>
                </div>

                <div>
                    <span class="student-stat-value">
                        @item.CreditsCompleted
                    </span>
                    <span class="student-stat-label">
                        Credits
                    </span>
                </div>

                <div>
                    <span class="student-stat-value">
                        @item.Age
                    </span>
                    <span class="student-stat-label">
                        Age
                    </span>
                </div>
            </div>
        </div>
    </div>


    <div class="student-progress">
        <div class="student-progress-head">
            <span>Academic Progress</span>
            <span>@progress%</span>
        </div>

        <div class="student-progress-track">
            <div class="student-progress-fill"
                 style="@("width:" + progress + "%;")">
            </div>
        </div>
    </div>


    <div class="student-advisor-line">
        <span class="student-advisor-label">
            Academic Advisor
        </span>

        <span class="student-advisor-name">
            @advisorName
        </span>
    </div>


    <div class="student-card-footer">
        <span class="student-view-text">
            View Details →
        </span>
    </div>
</article>}
}
        </div>
    </div>
</div>


