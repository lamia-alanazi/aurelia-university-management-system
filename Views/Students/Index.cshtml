        .student-full-hero {
            flex-direction: column;
            align-items: flex-start;
        }

        .student-panel-actions,
        .student-form-actions {
            flex-direction: column;
        }

        .student-panel-action,
        .student-cancel-button,
        .student-save-button {
            width: 100%;
