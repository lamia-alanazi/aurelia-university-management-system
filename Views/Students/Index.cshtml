    /* RESPONSIVE */

    @@media (max-width: 1050px) {
        .students-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 768px) {
        .students-container {
            width: 92%;
        }

        .students-header,
        .students-toolbar {
            flex-direction: column;
            align-items: flex-start;
        }

        .students-grid {
            grid-template-columns: 1fr;
        }

        .add-student-button {
            width: 100%;
            text-align: center;
        }

        .student-facts-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 560px) {
        .student-details-list,
        .student-form-grid,
        .student-contact-grid,
        .student-facts-grid {
            grid-template-columns: 1fr;
        }

        .student-details-item.full,
        .student-form-field.full {
            grid-column: auto;
