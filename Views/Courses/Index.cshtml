    /* FILTER MENU + MULTI CHECKBOX FILTERING */

    (function () {

        var wrap =
            document.getElementById(
                "courseFilterWrap"
            );

        var button =
            document.getElementById(
                "courseFilterButton"
            );

        var menu =
            document.getElementById(
                "courseFilterMenu"
            );

        var clearButton =
            document.getElementById(
                "courseFilterClear"
            );

        var allCheckbox =
            document.getElementById(
                "courseFilterAll"
            );

        var countBadge =
            document.getElementById(
                "courseFilterCount"
            );

        var checkboxes =
            document.querySelectorAll(
                ".course-filter-checkbox"
            );

        var cards =
            document.querySelectorAll(
                ".course-card"
            );


        function closeCourseFilterMenu() {

            menu.classList.remove(
                "open"
            );

            button.classList.remove(
                "open"
            );

            button.setAttribute(
                "aria-expanded",
                "false"
            );
        }


        function getSelectedCourseFilters() {

            var selected = [];

            for (
                var i = 0;
                i < checkboxes.length;
                i++
            ) {

                if (
                    checkboxes[i].value !== "All" &&
                    checkboxes[i].checked
                ) {

                    selected.push(
                        checkboxes[i].value
                    );
                }
            }

            return selected;
        }


        function updateCourseFilterBadge(
            selected
        ) {

            if (
                allCheckbox.checked ||
                selected.length === 0
            ) {

                countBadge.classList.remove(
                    "show"
                );

                countBadge.textContent =
                    "";

                return;
            }

            countBadge.textContent =
                selected.length;

            countBadge.classList.add(
                "show"
            );
        }


        function categoryMatchesFilter(
            category,
            filter
        ) {

            category =
                (category || "").trim();


            if (filter === "Other") {

                return (
                    mainCourseCategories.indexOf(
                        category
                    ) === -1
                );
            }

            return category === filter;
        }


        function applyCourseFilters() {

            var selected =
                getSelectedCourseFilters();


            if (
                !allCheckbox.checked &&
                selected.length === 0
            ) {

                allCheckbox.checked =
                    true;
            }


            if (allCheckbox.checked) {

                for (
                    var a = 0;
                    a < cards.length;
                    a++
                ) {

                    cards[a].style.display =
                        "";
                }

                updateCourseFilterBadge([]);

                return;
            }


            for (
                var c = 0;
                c < cards.length;
                c++
            ) {

                var category =
                    cards[c]
                        .getAttribute(
                            "data-category"
                        ) || "";

                var showCard =
                    false;


                for (
                    var s = 0;
                    s < selected.length;
                    s++
                ) {

                    if (
                        categoryMatchesFilter(
                            category,
                            selected[s]
                        )
                    ) {

                        showCard =
                            true;

                        break;
                    }
                }

                cards[c].style.display =
                    showCard
                        ? ""
                        : "none";
            }

            updateCourseFilterBadge(
                selected
            );
        }


        button.addEventListener(
            "click",
            function (event) {

                event.stopPropagation();

                if (
                    menu.classList.contains(
                        "open"
                    )
                ) {

                    closeCourseFilterMenu();

                }
                else {

                    menu.classList.add(
                        "open"
                    );

                    button.classList.add(
                        "open"
                    );

                    button.setAttribute(
                        "aria-expanded",
                        "true"
                    );
                }
            }
        );


        menu.addEventListener(
            "click",
            function (event) {

                event.stopPropagation();
            }
        );


        allCheckbox.addEventListener(
            "change",
            function () {

                if (this.checked) {

                    for (
                        var i = 0;
                        i < checkboxes.length;
                        i++
                    ) {

                        if (
                            checkboxes[i].value !==
                            "All"
                        ) {

                            checkboxes[i].checked =
                                false;
                        }
                    }
                }

                applyCourseFilters();
            }
        );


        for (
            var i = 0;
            i < checkboxes.length;
            i++
        ) {

            if (
                checkboxes[i].value ===
                "All"
            ) {

                continue;
            }


            checkboxes[i]
                .addEventListener(
                    "change",
                    function () {

                        if (this.checked) {

                            allCheckbox.checked =
                                false;
                        }

                        var selected =
                            getSelectedCourseFilters();

                        if (selected.length === 0) {

                            allCheckbox.checked =
                                true;
                        }

                        applyCourseFilters();
                    }
                );
        }


        clearButton.addEventListener(
            "click",
            function () {

                for (
                    var i = 0;
                    i < checkboxes.length;
                    i++
                ) {

                    checkboxes[i].checked =
                        checkboxes[i].value ===
                        "All";
                }

                applyCourseFilters();
            }
        );


        document.addEventListener(
            "click",
            function (event) {

                if (
                    wrap &&
                    !wrap.contains(
                        event.target
                    )
                ) {

                    closeCourseFilterMenu();
                }
            }
        );


        document.addEventListener(
            "keydown",
            function (event) {

                if (
                    event.key === "Escape" &&
                    menu.classList.contains(
                        "open"
                    )
                ) {

                    closeCourseFilterMenu();
                }
            }
        );


        applyCourseFilters();

   })();

        </script>

