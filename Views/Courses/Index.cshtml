            display: block;
        }


    .course-form-actions {
        margin-top: 26px;
        padding-top: 20px;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        border-top: 1px solid #d1d4d6;
    }


    /* DELETE */

    .delete-panel-content {
        position: relative;
        padding: 35px;
        background: #ffffff;
    }

    .delete-panel-small {
        margin-bottom: 7px;
        color: #596065;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 1.5px;
