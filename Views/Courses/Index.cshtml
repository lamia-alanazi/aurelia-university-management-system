@model IEnumerable<lamia12771.Models.Course>

@{ ViewBag.Title = "Courses";

    var courses = Model.ToList();

    var teachers =
        ViewBag.Teachers as System.Collections.Generic.List<lamia12771.Models.Teacher>
        ?? new System.Collections.Generic.List<lamia12771.Models.Teacher>();

    bool isAdmin =
        Session["IsAdmin"] != null
        && Session["IsAdmin"] is bool
        && (bool)Session["IsAdmin"]; }

<style>

    /* THEME */

    .courses-page {
        --page-bg: #ffffff;
        --card-bg: #f5f5f4;
        --text: #292c2f;
        --muted: #6f7478;
        --accent: #3E4348;
        --accent-hover: #2F3438;
        --border: #c9ccce;
        --soft-border: #d8dadd;
        --soft-bg: #eeeeec;
        background: #fbfaf7;
        width: 100%;
        min-height: 100vh;
        padding: 70px 0 90px;
        background: #fbfbfa;
        color: var(--text);
        font-family: Arial, sans-serif;
    }

    .courses-container {
        width: 88%;
        max-width: 1380px;
        margin: 0 auto;
    }


    /* HEADER */

    .courses-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 40px;
        padding-bottom: 30px;
        border-bottom: 1px solid #d8d9da;
    }

    .courses-heading-small {
        margin-bottom: 18px;
        display: flex;
        align-items: center;
        gap: 14px;
        color: #3E4348;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
    }



    .courses-header h1 {
        margin: 0;
        font-family: 'Times New Roman', serif;
        font-size: 52px;
        font-weight: 400;
        line-height: 1;
        color: #171717;
    }

    .courses-header p {
        max-width: 540px;
        margin: 17px 0 0;
        color: #6d7072;
        font-size: 12px;
        line-height: 1.8;
    }

    .courses-count {
        min-width: 145px;
        text-align: right;
    }

    .courses-count-number {
        display: block;
        width: 100%;
        padding-right: 37px;
        box-sizing: border-box;
        font-family: 'Times New Roman', serif;
        font-size: 34px;
        line-height: 1;
        color: #171717;
        text-align: center;
        transform: none;
    }

    .courses-count-label {
        display: block;
        margin-top: 9px;
        color: #777c80;
        font-size: 9px;
        letter-spacing: 1.2px;
        text-transform: uppercase;
    }


    /* TOOLBAR */

    .courses-toolbar {
        margin: 32px 0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 25px;
    }

    .course-filter-wrap {
        position: relative;
        display: inline-flex;
        align-items: center;
    }

    .course-filter-trigger {
        position: relative;
        width: 44px;
        height: 44px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #d8dadd;
        border-radius: 8px;
        background: #ffffff;
        color: #3E4348;
        cursor: pointer;
        transition: .25s ease;
    }

        .course-filter-trigger:hover,
        .course-filter-trigger.open {
            border-color: #3E4348;
            background: #f4f4f3;
        }

        .course-filter-trigger svg {
            width: 21px;
            height: 21px;
            display: block;
        }

    .course-filter-count {
        position: absolute;
        top: -6px;
        right: -6px;
        min-width: 18px;
        height: 18px;
        padding: 0 5px;
        display: none;
        align-items: center;
        justify-content: center;
        border: 2px solid #ffffff;
        border-radius: 20px;
        background: #3E4348;
        color: #ffffff;
        font-size: 8px;
        font-weight: 700;
        line-height: 1;
    }

        .course-filter-count.show {
            display: inline-flex;
        }

    .course-filter-menu {
        position: absolute;
        top: calc(100% + 10px);
        left: 0;
        z-index: 200;
        width: 265px;
        max-width: calc(100vw - 40px);
        padding: 15px;
        border: 1px solid #d7dadd;
        border-radius: 10px;
        background: #ffffff;
        box-shadow: 0 18px 45px rgba(32,36,40,.14);
        opacity: 0;
        visibility: hidden;
        transform: translateY(-5px);
        transition: .2s ease;
    }

        .course-filter-menu.open {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

    .course-filter-menu-head {
        margin-bottom: 10px;
        padding-bottom: 10px;
        border-bottom: 1px solid #eceeef;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .course-filter-menu-title {
        color: #3E4348;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 1.2px;
        text-transform: uppercase;
    }

    .course-filter-clear {
        padding: 0;
        border: 0;
        background: transparent;
        color: #777777;
        font-size: 9px;
        text-transform: uppercase;
        cursor: pointer;
    }

        .course-filter-clear:hover {
            color: #3E4348;
        }

    .course-filter-option {
        min-height: 36px;
        display: flex;
        align-items: center;
        gap: 10px;
        cursor: pointer;
        color: #44494d;
        font-size: 11px;
        user-select: none;
    }

        .course-filter-option + .course-filter-option {
            border-top: 1px solid #f0f1f1;
        }

        .course-filter-option input {
            position: absolute;
            opacity: 0;
            pointer-events: none;
        }

    .course-filter-check {
        width: 16px;
        height: 16px;
        flex: 0 0 16px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #bfc3c5;
        border-radius: 3px;
        background: #ffffff;
        transition: .2s ease;
    }

    .course-filter-option input:checked + .course-filter-check {
        border-color: #3E4348;
        background: #3E4348;
    }

        .course-filter-option input:checked + .course-filter-check:after {
            content: "";
            width: 7px;
            height: 4px;
            border-left: 2px solid #ffffff;
            border-bottom: 2px solid #ffffff;
            transform: rotate(-45deg) translateY(-1px);
        }

    .course-filter-option input:focus + .course-filter-check {
        box-shadow: 0 0 0 2px rgba(62,67,72,.12);
    }

    .course-filter-option-text {
        flex: 1;
        min-width: 0;
    }


    /* ADD BUTTON */

    .course-add-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 12px 21px;
        border: 1px solid var(--accent);
        background: var(--accent);
        color: #ffffff;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .7px;
        text-transform: uppercase;
        cursor: pointer;
        transition: .25s ease;
    }

        .course-add-btn:hover {
            background: var(--accent-hover);
            border-color: var(--accent-hover);
        }


    /* COURSE GRID */

    .courses-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px;
    }

    .courses-empty {
        grid-column: 1 / -1;
        padding: 60px 20px;
        text-align: center;
        border: 1px solid var(--border);
        color: var(--muted);
    }


    /* COURSE CARD */

    .course-card {
        position: relative;
        overflow: hidden;
        background: #ffffff;
        border: 1px solid #dedbd5;
        border-radius: 7px;
        box-shadow: 0 8px 24px rgba(32, 36, 40, 0.055);
        cursor: pointer;
        transition: transform .28s ease, box-shadow .28s ease, border-color .28s ease;
    }

        .course-card:hover {
            transform: translateY(-5px);
            border-color: #c4b89f;
            box-shadow: 0 18px 42px rgba(32, 36, 40, .12);
        }

    .course-meta-row {
        color: #5f6468;
    }

    .courses-grid {
        margin-top: 8px;
    }

    .course-card:hover {
        transform: translateY(-6px);
        border-color: #8f969c;
        box-shadow: 0 18px 42px rgba(32, 36, 40, 0.13);
    }


    /* COURSE VISUAL */

    .course-visual {
        position: relative;
        width: calc(100% - 16px);
        height: 205px;
        margin: 8px 8px 0;
        overflow: hidden;
        background: #eeeeec;
        border: 1px solid #e1e3e4;
        border-radius: 5px;
    }

        .course-visual img {
            width: 100%;
            height: 100%;
            display: block;
            object-fit: cover;
            object-position: center;
            transition: transform .4s ease, filter .4s ease;
        }

    .course-card:hover .course-visual img {
        transform: scale(1.035);
        filter: brightness(1.04);
    }

    .course-code,
    .course-credit {
        position: absolute;
        z-index: 3;
        top: 13px;
        padding: 7px 10px;
        border: 1px solid rgba(255,255,255,.22);
        border-radius: 6px;
        background: rgba(55,57,59,.88);
        color: #ffffff;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 1px;
    }

    .course-code {
        left: 13px;
    }

    .course-credit {
        right: 13px;
    }


    /* CARD BODY */

    .course-card-body {
        padding: 16px 16px 8px;
    }

    .course-category {
        margin-bottom: 8px;
        color: #596065;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 1.1px;
        text-transform: uppercase;
    }

    .course-title {
        margin-bottom: 11px;
        font-family: 'Times New Roman', serif;
        font-size: 22px;
        font-weight: 400;
        line-height: 1.25;
        color: #171717;
    }

    .course-meta {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .course-meta-row {
        display: flex;
        align-items: center;
        gap: 9px;
        color: #555c61;
        font-size: 10px;
        line-height: 1.4;
    }

    .course-meta-icon {
        width: 16px;
        min-width: 16px;
        height: 16px;
        color: #777c80;
    }

        .course-meta-icon svg {
            width: 100%;
            height: 100%;
            display: block;
            fill: none;
            stroke: currentColor;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }




    /* OVERLAY */

    .course-overlay {
        position: fixed;
        inset: 0;
        z-index: 9998;
        background: rgba(20,21,22,.65);
        backdrop-filter: blur(3px);
        opacity: 0;
        visibility: hidden;
        transition: .3s ease;
    }

        .course-overlay.open {
            opacity: 1;
            visibility: visible;
        }


    /* ALL PANELS */

    .course-panel,
    .course-full-panel,
    .course-form-panel,
    .course-delete-panel {
        position: fixed;
        top: 50%;
        left: 50%;
        z-index: 9999;
        max-width: 94%;
        max-height: 92vh;
        overflow-y: auto;
        overflow-x: hidden;
        background: #ffffff;
        color: #202326;
        border: 1px solid #c8cbcd;
        border-radius: 18px;
        box-shadow: 0 30px 90px rgba(0,0,0,.28);
        opacity: 0;
        visibility: hidden;
        transform: translate(-50%, -47%) scale(.97);
        transition: opacity .28s ease, visibility .28s ease, transform .32s ease;
    }

    .course-panel {
        width: 820px;
    }

    .course-full-panel {
        width: 880px;
    }

    .course-form-panel {
        width: 780px;
    }

    .course-delete-panel {
        width: 540px;
    }

        .course-panel.open,
        .course-full-panel.open,
        .course-form-panel.open,
        .course-delete-panel.open {
            opacity: 1;
            visibility: visible;
            transform: translate(-50%, -50%) scale(1);
        }

        .course-panel::-webkit-scrollbar,
        .course-full-panel::-webkit-scrollbar,
        .course-form-panel::-webkit-scrollbar,
        .course-delete-panel::-webkit-scrollbar {
            width: 8px;
        }

        .course-panel::-webkit-scrollbar-thumb,
        .course-full-panel::-webkit-scrollbar-thumb,
        .course-form-panel::-webkit-scrollbar-thumb,
        .course-delete-panel::-webkit-scrollbar-thumb {
            background: #a5a9ac;
            border-radius: 20px;
        }


    /* OVERVIEW IMAGE */

    .course-panel-visual {
        position: relative;
        width: 100%;
        height: 245px;
        overflow: hidden;
        background: radial-gradient( circle at center, #292c30 0%, #202225 62%, #191b1e 100% );
        border-radius: 18px 18px 0 0;
    }

        .course-panel-visual img {
            width: 100%;
            height: 100%;
            display: block;
            object-fit: cover;
            object-position: center;
        }

    .course-panel-code,
    .course-panel-credit {
        position: absolute;
        z-index: 3;
        top: 18px;
        padding: 8px 12px;
        background: rgba(47,50,53,.92);
        border: 1px solid rgba(255,255,255,.22);
        border-radius: 7px;
        color: #ffffff;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 1px;
    }

    .course-panel-code {
        left: 18px;
    }

    .course-panel-credit {
        right: 68px;
    }


    /* CLOSE */

    .panel-close {
        position: absolute;
        z-index: 20;
        top: 15px;
        right: 17px;
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        border: 1px solid rgba(255,255,255,.22);
        border-radius: 50%;
        background: rgba(47,50,53,.92);
        color: #ffffff;
        font-size: 21px;
        cursor: pointer;
        transition: .2s ease;
    }

        .panel-close:hover {
            background: var(--accent-hover);
        }


    /* COURSE OVERVIEW */

    .overview-body {
        padding: 30px 36px 34px;
        background: #ffffff;
    }

    .overview-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 24px;
    }

    .overview-category {
        margin-bottom: 8px;
        color: #5c6266;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1.4px;
        text-transform: uppercase;
    }

    .overview-title {
        margin: 0;
        font-family: 'Times New Roman', serif;
        font-size: 38px;
        font-weight: 400;
        color: #171717;
    }

    .overview-code {
        margin-top: 7px;
        color: #73787c;
        font-size: 11px;
        letter-spacing: 1px;
    }

    .overview-status {
        padding: 9px 13px;
        border: 1px solid #d1d4d6;
        border-radius: 20px;
        background: #eeeeec;
        color: #3E4348;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: .8px;
        text-transform: uppercase;
        white-space: nowrap;
    }


    /* OVERVIEW STATS */

    .overview-stats {
        margin: 28px 0 24px;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
    }

    .overview-stat {
        min-height: 92px;
        padding: 16px 12px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        background: #eeeeec;
        border: 1px solid #d1d4d6;
        border-radius: 12px;
    }

    .overview-stat-value {
        display: block;
        font-family: 'Times New Roman', serif;
        font-size: 22px;
        color: #171717;
    }

    .overview-stat-label {
        margin-top: 7px;
        color: #697075;
        font-size: 8px;
        font-weight: 700;
        letter-spacing: .9px;
        text-transform: uppercase;
    }


    /* IMPORTANT INFORMATION */

    .overview-info {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
    }

    .overview-info-item {
        padding: 15px;
        background: #f4f4f3;
        border: 1px solid #d5d7d9;
        border-radius: 10px;
    }

        .overview-info-item.full {
            grid-column: 1 / -1;
        }

    .overview-info-label {
        display: block;
        margin-bottom: 7px;
        color: #62686c;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .overview-info-value {
        display: block;
        color: #24282b;
        font-size: 14px;
        line-height: 1.6;
    }


    /* ACTION BUTTONS */

    .course-panel-actions {
        position: sticky;
        bottom: 0;
        z-index: 30;
        padding: 18px 36px;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
        background: #ffffff;
        border-top: 1px solid #d1d4d6;
        box-shadow: 0 -8px 24px rgba(0,0,0,.05);
    }

    .panel-action-btn {
        min-width: 135px;
        display: inline-flex !important;
        align-items: center;
        justify-content: center;
        padding: 12px 20px;
        border: 1px solid #bfc3c5;
        background: #ffffff;
        color: #4d5256;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .7px;
        text-transform: uppercase;
        visibility: visible !important;
        opacity: 1 !important;
        cursor: pointer;
        transition: .2s ease;
    }

        .panel-action-btn:hover {
            border-color: var(--accent);
            color: var(--accent);
        }

        .panel-action-btn.primary {
            background: var(--accent);
            border-color: var(--accent);
            color: #ffffff;
        }

            .panel-action-btn.primary:hover {
                background: var(--accent-hover);
                border-color: var(--accent-hover);
                color: #ffffff;
            }

        .panel-action-btn.danger:hover {
            border-color: #8d5555;
            color: #8d5555;
        }

    #courseOverviewEditButton {
        display: inline-flex !important;
        visibility: visible !important;
        opacity: 1 !important;
        position: static !important;
        min-width: 135px !important;
        width: auto !important;
        height: auto !important;
        background: #3E4348 !important;
        border-color: #3E4348 !important;
        color: #ffffff !important;
    }

        #courseOverviewEditButton:hover {
            background: #2F3438 !important;
            border-color: #2F3438 !important;
            color: #ffffff !important;
        }


    /* WHITE PANEL HEADERS */

    .white-panel-header,
    .form-panel-header {
        position: relative;
        padding: 29px 32px 24px;
        background: #ffffff;
        border-bottom: 1px solid #d1d4d6;
    }

    .white-panel-small,
    .form-panel-small {
        margin-bottom: 7px;
        color: #596065;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
    }

    .white-panel-header h2,
    .form-panel-header h2 {
        margin: 0;
        padding-right: 55px;
        font-family: 'Times New Roman', serif;
        font-size: 32px;
        font-weight: 400;
        color: #171717;
    }

    .white-panel-header p,
    .form-panel-header p {
        max-width: 560px;
        margin: 8px 0 0;
        color: #6d7377;
        font-size: 11px;
        line-height: 1.7;
    }

    .white-close {
        position: absolute;
        top: 26px;
        right: 26px;
        width: 42px;
        height: 42px;
        border: 1px solid #3E4348;
        border-radius: 50%;
        background: #3E4348;
        color: #ffffff;
        font-size: 21px;
        cursor: pointer;
        transition: .2s ease;
    }

        .white-close:hover {
            background: #2F3438;
            border-color: #2F3438;
        }


    /* FULL DETAILS */

    .full-details-body {
        padding: 30px 32px 34px;
        background: #ffffff;
    }

    .full-details-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 13px;
    }

    .full-detail-item {
        padding: 16px 18px;
        background: #eeeeec;
        border: 1px solid #d1d4d6;
        border-radius: 10px;
    }

        .full-detail-item.full {
            grid-column: 1 / -1;
        }

    .full-detail-label {
        display: block;
        margin-bottom: 8px;
        color: #62686c;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .full-detail-value {
        display: block;
        color: #202326;
        font-size: 14px;
        line-height: 1.75;
        word-break: break-word;
    }


    /* TOPICS */

    .course-topic-list {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .course-topic-item {
        display: grid;
        grid-template-columns: 36px 1fr;
        gap: 9px;
        margin-bottom: 12px;
        color: #202326;
        font-size: 14px;
        line-height: 1.6;
    }

    .topic-number {
        color: #444a4e;
        font-size: 10px;
        font-weight: 700;
    }


    /* MATERIALS */

    .course-material {
        padding: 11px 0;
        display: grid;
        grid-template-columns: 32px 1fr 35px;
        align-items: center;
        gap: 10px;
        border-bottom: 1px solid #cfd2d4;
    }

        .course-material:first-of-type {
            border-top: 1px solid #cfd2d4;
        }

    .material-icon {
        width: 31px;
        height: 31px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #ffffff;
        border: 1px solid #d1d4d6;
        border-radius: 6px;
        color: #555b5f;
    }

    .material-name {
        color: #383d40;
        font-size: 13px;
    }

    .material-type {
        color: #777d81;
        font-size: 10px;
    }


    /* ANNOUNCEMENTS */

    .course-announcement {
        margin-bottom: 14px;
        padding: 5px 0 6px 15px;
        border-left: 2px solid #3E4348;
    }

    .announcement-date {
        display: block;
        margin-bottom: 6px;
        color: #666c70;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .announcement-text {
        color: #3f4447;
        font-size: 13px;
        line-height: 1.7;
    }


    /* ADD / EDIT FORM نفس تصميم Rooms */

    .course-form-body {
        padding: 30px 32px 34px;
        background: #ffffff;
    }

    .course-form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 18px;
    }

    .course-form-group.full {
        grid-column: 1 / -1;
    }

    .course-form-label {
        display: block;
        margin-bottom: 8px;
        color: #4e5559;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .course-form-control {
        width: 100%;
        box-sizing: border-box;
        padding: 12px 14px;
        border: 1px solid #c9ccce;
        border-radius: 8px;
        background: #eeeeec;
        color: #202326;
        font-family: Arial, sans-serif;
        font-size: 13px;
        outline: none;
        transition: .2s ease;
    }

    input.course-form-control,
    select.course-form-control {
        height: 54px;
    }

    textarea.course-form-control {
        min-height: 112px;
        resize: vertical;
        line-height: 1.6;
    }

    .course-form-control::placeholder {
        color: #8a8f93;
    }

    .course-form-control:focus {
        border-color: #3E4348;
        background: #f4f4f3;
        box-shadow: 0 0 0 2px rgba(62,67,72,.08);
    }

    .course-form-control option {
        background: #ffffff;
        color: #171717;
    }

    .course-form-help {
