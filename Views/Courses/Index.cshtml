</style>


<div class="courses-page">

    <div class="courses-container">


        <!-- HEADER -->

        <div class="courses-header">

            <div>

                <div class="courses-heading-small">
                    Academic Catalog
                </div>

                <h1>
                    Courses
                </h1>

                <p>
                    Explore available courses, schedules,
                    instructors, and course information.
                </p>

            </div>


            <div class="courses-count">

                <span class="courses-count-number">
                    @courses.Count
                </span>

                <span class="courses-count-label">
                    Courses Offered
                </span>

            </div>

        </div>



        <!-- TOOLBAR -->

        <div class="courses-toolbar">

            <div class="course-filter-wrap"
                 id="courseFilterWrap">

                <button type="button"
                        class="course-filter-trigger"
                        id="courseFilterButton"
                        aria-label="Filter courses by category"
                        aria-expanded="false"
                        aria-controls="courseFilterMenu">

                    <svg viewBox="0 0 24 24"
                         aria-hidden="true">
                        <path d="M4 5h16l-6.3 7.1v5.2l-3.4 1.8v-7L4 5z"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="1.8"
                              stroke-linejoin="round" />
                        <path d="M16.5 8.5h3.5M15.5 12h4.5M17 15.5h3"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="1.8"
                              stroke-linecap="round" />
                    </svg>

                    <span class="course-filter-count"
                          id="courseFilterCount">
                    </span>

                </button>


                <div class="course-filter-menu"
                     id="courseFilterMenu">

                    <div class="course-filter-menu-head">

                        <span class="course-filter-menu-title">
                            Filter by Category
                        </span>

                        <button type="button"
                                class="course-filter-clear"
                                id="courseFilterClear">
                            Clear
                        </button>

                    </div>

                    <label class="course-filter-option">
                        <input type="checkbox"
                               class="course-filter-checkbox"
                               value="All"
                               id="courseFilterAll"
                               checked />
                        <span class="course-filter-check"></span>
                        <span class="course-filter-option-text">All Courses</span>
                    </label>

                    <label class="course-filter-option">
                        <input type="checkbox"
                               class="course-filter-checkbox"
                               value="Computer Science" />
                        <span class="course-filter-check"></span>
                        <span class="course-filter-option-text">Computer Science</span>
                    </label>

                    <label class="course-filter-option">
                        <input type="checkbox"
                               class="course-filter-checkbox"
                               value="Biology" />
                        <span class="course-filter-check"></span>
                        <span class="course-filter-option-text">Biology</span>
                    </label>

                    <label class="course-filter-option">
                        <input type="checkbox"
                               class="course-filter-checkbox"
                               value="Chemistry" />
                        <span class="course-filter-check"></span>
                        <span class="course-filter-option-text">Chemistry</span>
                    </label>

                    <label class="course-filter-option">
                        <input type="checkbox"
                               class="course-filter-checkbox"
                               value="Engineering" />
                        <span class="course-filter-check"></span>
                        <span class="course-filter-option-text">Engineering</span>
                    </label>

                    <label class="course-filter-option">
                        <input type="checkbox"
                               class="course-filter-checkbox"
                               value="Geography" />
                        <span class="course-filter-check"></span>
                        <span class="course-filter-option-text">Geography</span>
                    </label>

                    <label class="course-filter-option">
                        <input type="checkbox"
                               class="course-filter-checkbox"
                               value="Other" />
                        <span class="course-filter-check"></span>
                        <span class="course-filter-option-text">Other</span>
                    </label>

                </div>

            </div>


            @if (isAdmin)
            {
                <button type="button"
                        class="course-add-btn"
                        onclick="openAddCoursePanel()">
                    Add New Course
                </button>   }

        </div>


        <!-- COURSE CARDS -->

        <div class="courses-grid">

            @if (courses.Count == 0)
            {
                <div class="courses-empty">
                    No courses have been added yet.
                </div> }
            else
            {
                for (int i = 0; i < courses.Count; i++)
                {
                    var course = courses[i];

                    var instructorText =
                        course.Teacher != null &&
                        !string.IsNullOrWhiteSpace(course.Teacher.Name)
                            ? course.Teacher.Name
                            : (
                                string.IsNullOrWhiteSpace(course.Instructor)
                                    ? "Not Assigned"
                                    : course.Instructor
                              );

                    var scheduleText =
                        string.IsNullOrWhiteSpace(course.Schedule)
                            ? "Schedule Not Assigned"
                            : course.Schedule;

                    var locationText =
                        string.IsNullOrWhiteSpace(course.Location)
                            ? "Location Not Assigned"
                            : course.Location;


                    <article class="course-card"
                             data-category="@course.Category"
                             onclick="openCoursePanel(@i)">

                        <div class="course-visual">

                            @if (!string.IsNullOrWhiteSpace(course.ImagePath))
                            {
                                <img src="@course.ImagePath"
                                     alt="@course.CourseName"
                                     onerror="this.style.display='none';" />}

                            <span class="course-code">
                                @course.CourseCode
                            </span>

                            <span class="course-credit">
                                @course.CreditHours CR
                            </span>

                        </div>


                        <div class="course-card-body">

                            <div class="course-category">
                                @course.Category
                            </div>

                            <h3 class="course-title">
                                @course.CourseName
                            </h3>


                            <div class="course-meta">

                                <div class="course-meta-row">

                                    <span class="course-meta-icon">

                                        <svg viewBox="0 0 24 24">

                                            <circle cx="12"
                                                    cy="7"
                                                    r="3">
                                            </circle>

                                            <path d="M6 21c.6-5 2.6-8 6-8s5.4 3 6 8">
                                            </path>

                                        </svg>

                                    </span>

                                    @instructorText

                                </div>


                                <div class="course-meta-row">

                                    <span class="course-meta-icon">

                                        <svg viewBox="0 0 24 24">

                                            <circle cx="12"
                                                    cy="12"
                                                    r="9">
