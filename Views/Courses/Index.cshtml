            flex-direction: column;
        }

        .course-panel-actions,
        .course-form-actions,
        .delete-panel-actions {
            flex-direction: column;
        }

        .panel-action-btn {
            width: 100%;
            box-sizing: border-box;
        }
    }
    /* AURELIA UNIFIED DESIGN Matches Courses with Rooms CSS ONLY - DOES NOT AFFECT FUNCTIONS */

