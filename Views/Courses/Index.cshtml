        <script>

    var isAdmin =
        @isAdmin.ToString().ToLower();

    /* DATABASE COURSES */

    var coursesData = [

    @for (int i = 0; i < courses.Count; i++)
    {
        var course = courses[i];

        var displayInstructor =
            course.Teacher != null &&
            !string.IsNullOrWhiteSpace(course.Teacher.Name)
                ? course.Teacher.Name
                : (course.Instructor ?? "");

        <text>
        {
            id:
                @course.CourseId,

            title:
                '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(course.CourseName ?? ""))',

            credits:
                '@course.CreditHours',

            code:
                '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(course.CourseCode ?? ""))',

            category:
                '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(course.Category ?? ""))',

            teacherId:
                '@(course.TeacherId.HasValue ? course.TeacherId.Value.ToString() : "")',

            instructor:
                '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(displayInstructor))',

            legacyInstructor:
                '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(course.Instructor ?? ""))',

            schedule:
                '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(course.Schedule ?? ""))',

            location:
                '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(course.Location ?? ""))',

            image:
                '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(course.ImagePath ?? ""))',

            description:
                '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(course.Description ?? ""))',

            topics:
                '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(course.Topics ?? ""))'
        }@(i < courses.Count - 1 ? "," : "")
        </text>
    }

    ];


    var selectedCourse =
        null;


    var mainCourseCategories = [
        "Computer Science",
        "Biology",
        "Chemistry",
        "Engineering",
        "Geography"
    ];


    function isMainCourseCategory(category) {

        return mainCourseCategories.indexOf(
            category
        ) !== -1;
    }


    function updateCourseCategoryValue() {

        var select =
            document.getElementById(
                "formCategory"
            );

        var otherField =
            document.getElementById(
                "otherCategoryField"
            );

        var otherInput =
            document.getElementById(
                "otherCategoryInput"
            );

        var hiddenValue =
            document.getElementById(
                "formCategoryValue"
            );


        if (select.value === "Other") {

            otherField.classList.add(
                "open"
            );

            otherInput.required =
                true;

            hiddenValue.value =
                otherInput.value.trim();

        }
        else {

            otherField.classList.remove(
                "open"
            );

            otherInput.required =
                false;

            otherInput.value =
                "";

            hiddenValue.value =
                select.value;
        }
    }


    function setCourseCategory(category) {

        var select =
            document.getElementById(
                "formCategory"
            );

        var otherInput =
            document.getElementById(
                "otherCategoryInput"
            );


        if (!category || !category.trim()) {

            select.value =
                "";

            otherInput.value =
                "";

            updateCourseCategoryValue();

            return;
        }


        if (isMainCourseCategory(category)) {

            select.value =
                category;

            otherInput.value =
                "";

            updateCourseCategoryValue();

        }
        else {

            select.value =
                "Other";

            otherInput.value =
                category;

            updateCourseCategoryValue();

            otherInput.value =
                category;

            document
                .getElementById(
                    "formCategoryValue"
                )
                .value =
                category;
        }
    }


    /* INSTRUCTOR FILTER Shows only teachers whose Subject matches Course Category */

    function getCurrentCourseCategory() {

        var categorySelect =
            document.getElementById(
                "formCategory"
            );

        var otherInput =
            document.getElementById(
                "otherCategoryInput"
            );


        if (
            categorySelect.value ===
            "Other"
        ) {
            return (
                otherInput.value ||
                ""
            ).trim();
        }


        return (
            categorySelect.value ||
            ""
        ).trim();
    }


    function syncLegacyInstructorValue() {

        var teacherSelect =
            document.getElementById(
                "formTeacherId"
            );

        var hiddenInstructor =
            document.getElementById(
                "formInstructor"
            );


        if (
            !teacherSelect ||
            !hiddenInstructor
        ) {
            return;
        }


        if (
            !teacherSelect.value
        ) {
            hiddenInstructor.value =
                "";

            return;
        }


        var selectedOption =
            teacherSelect.options[
                teacherSelect.selectedIndex
            ];


        hiddenInstructor.value =
            selectedOption
                ? (
                    selectedOption.getAttribute(
                        "data-name"
                    ) ||
                    ""
                  )
                : "";
    }


    function filterInstructorOptions(
        preferredTeacherId
    ) {

        var teacherSelect =
            document.getElementById(
                "formTeacherId"
            );

        var helpText =
            document.getElementById(
                "formTeacherHelp"
            );


        if (!teacherSelect) {
            return;
        }


        var category =
            getCurrentCourseCategory();

        var preferredValue =
            preferredTeacherId !== undefined &&
            preferredTeacherId !== null
                ? String(
                    preferredTeacherId
                  )
                : teacherSelect.value;

        var hasPreferredMatch =
            false;

        var matchingCount =
            0;


        for (
            var i = 0;
            i < teacherSelect.options.length;
            i++
        ) {
            var option =
                teacherSelect.options[i];


            // Keep "Not Assigned" available at all times
            if (i === 0) {
                option.hidden =
                    false;

                option.disabled =
                    false;

                continue;
            }


            var subject =
                (
                    option.getAttribute(
                        "data-subject"
                    ) ||
                    ""
                ).trim();


            var isMatch =
                category !== "" &&
                subject.toLowerCase() ===
                category.toLowerCase();


            option.hidden =
                !isMatch;

            option.disabled =
                !isMatch;


            if (isMatch) {
                matchingCount++;

                if (
                    option.value ===
                    preferredValue
                ) {
                    hasPreferredMatch =
                        true;
                }
            }
        }


        teacherSelect.value =
            hasPreferredMatch
                ? preferredValue
                : "";


        syncLegacyInstructorValue();


        if (helpText) {

            if (!category) {
                helpText.innerText =
                    "Select a course category to see matching faculty members.";
            }
            else if (
                matchingCount === 0
            ) {
                helpText.innerText =
                    "No faculty member currently matches this course category.";
            }
            else {
                helpText.innerText =
                    "Showing faculty members whose subject matches this course category.";
            }
        }
    }


    /* HELPERS */

    function hideCoursePanels() {

        document
            .getElementById(
                "coursePanel"
            )
            .classList
            .remove(
                "open"
            );


        document
            .getElementById(
                "courseFullPanel"
            )
            .classList
            .remove(
                "open"
            );


        document
            .getElementById(
                "courseFormPanel"
            )
            .classList
            .remove(
                "open"
            );


        document
            .getElementById(
                "courseDeletePanel"
