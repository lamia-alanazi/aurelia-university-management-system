    /* TOPICS */

    function loadCourseTopics(
        containerId,
        topicsText
    ) {

        var container =
            document.getElementById(
                containerId
            );


        container.innerHTML =
            "";


        if (
            !topicsText ||
            topicsText.trim() === ""
        ) {

            var emptyItem =
                document.createElement(
                    "li"
                );


            emptyItem.className =
                "course-topic-item";


            emptyItem.innerHTML =
                "<span class='topic-number'>—</span>" +
                "<span>No course topics have been added yet.</span>";


            container.appendChild(
                emptyItem
            );


            return;
        }


        var topicList =
            topicsText.split("|");


        var visibleNumber =
            1;


        for (
            var i = 0;
            i < topicList.length;
            i++
        ) {

            var topicText =
                topicList[i].trim();


            if (
                topicText === ""
            ) {
                continue;
            }


            var item =
                document.createElement(
                    "li"
                );


            item.className =
                "course-topic-item";


            var number =
                document.createElement(
                    "span"
                );


            number.className =
                "topic-number";


            number.innerText =
                (
                    visibleNumber < 10
                        ? "0"
                        : ""
                ) +
                visibleNumber;


            var title =
                document.createElement(
                    "span"
                );


            title.innerText =
                topicText;


            item.appendChild(
                number
            );


            item.appendChild(
                title
            );


            container.appendChild(
                item
            );


            visibleNumber++;
        }
    }


