                              stroke="none">
                        </rect>

                        <rect x="9"
                              y="9"
                              width="2"
                              height="9"
                              fill="currentColor"
                              stroke="none">
                        </rect>

                        <rect x="13"
                              y="9"
                              width="2"
                              height="9"
                              fill="currentColor"
                              stroke="none">
                        </rect>

                        <rect x="17"
                              y="9"
                              width="2"
                              height="9"
                              fill="currentColor"
                              stroke="none">
                        </rect>

                        <rect x="4"
                              y="18"
                              width="16"
                              height="2"
                              fill="currentColor"
                              stroke="none">
                        </rect>

                        <rect x="3"
                              y="21"
                              width="18"
                              height="1.5"
                              fill="currentColor"
                              stroke="none">
                        </rect>

                    </svg>

                </div>

                <div class="stat-number">
                    1.2M m²
                </div>

                <div class="stat-title">
                    Campus Area
                </div>

            </div>


            <!-- STAT 4 -->

            <div class="university-stat">

                <div class="stat-icon">

                    <svg viewBox="0 0 24 24">

                        <circle cx="12"
                                cy="7"
                                r="3"
                                fill="currentColor"
                                stroke="none">
                        </circle>

                        <path d="M6.5 20C7 15.5 9 13 12 13C15 13 17 15.5 17.5 20Z"
                              fill="currentColor"
