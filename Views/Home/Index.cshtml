<script>

    var programs = [

        {
            title: "Accounting",

            category:
                "Economics & Finance",

            subtitle:
                "Financial Analysis & Business",

            description:
                "Explore financial reporting, budgeting, auditing, cost analysis, and the economic principles that support modern organizations.",

            video:
                "/images/accounting.mp4?v=@videoVersion"},

        {
            title:
                "Mathematics",

            category:
                "Logic & Analysis",

            subtitle:
                "Numbers, Reasoning & Problem Solving",

            description:
                "Develop strong analytical and problem-solving skills through algebra, statistics, mathematical analysis, and quantitative reasoning.",

            video:
                "/images/mathematics.mp4?v=@videoVersion"},

        {
            title:
                "Biology",

            category:
                "Life Sciences",

            subtitle:
                "Living Systems & Scientific Research",

            description:
                "Explore living organisms, genetics, cells, ecosystems, and biological systems through scientific study and research.",

            video:
                "/images/biology.mp4?v=@videoVersion"}

    ];


    var currentIndex = 0;


    function updatePrograms() {

        var current =
            programs[currentIndex];


        var leftIndex =
            (currentIndex - 1 + programs.length)
            % programs.length;


        var rightIndex =
            (currentIndex + 1)
            % programs.length;


        document.getElementById("programTitle").innerText =
            current.title;


        document.getElementById("programCategory").innerText =
            current.category;


        document.getElementById("programSubtitle").innerText =
            current.subtitle;


        document.getElementById("programDescription").innerText =
            current.description;


        document.getElementById("currentProgram").innerText =
            currentIndex + 1;



        /* MAIN VIDEO */

        var mainVideo =
            document.getElementById("mainVideo");

        var mainVideoSource =
            document.getElementById("mainVideoSource");


        mainVideoSource.src =
            current.video;

        mainVideo.load();

        mainVideo.play()
            .catch(function () { });



        /* LEFT VIDEO */

        var leftPreviewVideo =
            document.getElementById("leftPreviewVideo");

        var leftVideoSource =
            document.getElementById("leftVideo");


        leftVideoSource.src =
            programs[leftIndex].video;

        leftPreviewVideo.load();

        leftPreviewVideo.play()
            .catch(function () { });


        document.getElementById("leftLabel").innerText =
            programs[leftIndex].title;



        /* RIGHT VIDEO */

        var rightPreviewVideo =
            document.getElementById("rightPreviewVideo");

        var rightVideoSource =
            document.getElementById("rightVideo");


        rightVideoSource.src =
            programs[rightIndex].video;

        rightPreviewVideo.load();

        rightPreviewVideo.play()
            .catch(function () { });


        document.getElementById("rightLabel").innerText =
            programs[rightIndex].title;
    }


    function nextProgram() {

        currentIndex =
            (currentIndex + 1)
            % programs.length;

        updatePrograms();
    }


    function previousProgram() {

        currentIndex =
            (currentIndex - 1 + programs.length)
            % programs.length;

        updatePrograms();
    }

</script>