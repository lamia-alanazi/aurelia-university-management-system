                        <path d="M22.5 19C22 15.5 20.7 13.5 18.7 13.5C17.6 13.5 16.7 14 16 15"
                              stroke="currentColor"
                              opacity="0.45">
                        </path>

                    </svg>

                </div>

                <div class="stat-number">
                    25+
                </div>

                <div class="stat-title">
                    Faculty Members
                </div>

            </div>

        </div>

    </section>


    <!-- ACADEMIC PROGRAMS -->

    <section class="programs-section">

        <div class="programs-inner">

            <div class="programs-heading">

                <span class="dot"></span>

                <h2>
                    Academic Programs.
                </h2>

                <p>
                    Explore the academic majors available at Aurelia University.
                </p>

            </div>


            <div class="programs-slider">


                <!-- LEFT PREVIEW -->

                <div class="program-side">

                    <video id="leftPreviewVideo"
                           autoplay
                           muted
                           loop
                           playsinline
                           preload="auto">

                        <source id="leftVideo"
                                src="/images/biology.mp4?v=@videoVersion"
                                type="video/mp4" />

                    </video>

                    <div class="program-side-label"
                         id="leftLabel">
                        Biology
                    </div>

                </div>


                <!-- MAIN CARD -->

                <div class="program-main">


                    <!-- VIDEO -->

                    <div class="program-media">

                        <!-- Main video -->

                        <video id="mainVideo"
                               class="program-video-main"
                               autoplay
                               muted
                               loop
                               playsinline
                               preload="auto">

                            <source id="mainVideoSource"
                                    src="/images/accounting.mp4?v=@videoVersion"
                                    type="video/mp4" />

                        </video>

                    </div>


                    <!-- INFORMATION -->

                    <div class="program-info">

                        <div class="program-category"
                             id="programCategory">
                            Economics &amp; Finance
                        </div>

                        <h3 id="programTitle">
                            Accounting
                        </h3>

                        <h4 id="programSubtitle">
                            Financial Analysis &amp; Business
                        </h4>

                        <p id="programDescription">
                            Explore financial reporting, budgeting,
                            auditing, cost analysis, and the economic
                            principles that support modern organizations.
                        </p>


                        <div class="program-controls">

                            <button class="program-arrow"
                                    type="button"
                                    onclick="previousProgram()">
                                &#10094;
                            </button>


                            <div class="program-number">

                                <span id="currentProgram">
                                    1
                                </span>

                                / 3

                            </div>


                            <button class="program-arrow"
                                    type="button"
                                    onclick="nextProgram()">
                                &#10095;
                            </button>

                        </div>

                    </div>

                </div>


                <!-- RIGHT PREVIEW -->

                <div class="program-side">

                    <video id="rightPreviewVideo"
                           autoplay
                           muted
                           loop
                           playsinline
