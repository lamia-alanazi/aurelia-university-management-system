@model lamia12771.Models.Room

@{
    ViewBag.Title = "Delete Room";
}

<div class="container">

    <div class="row">
        <div class="col-md-8 col-md-offset-2">

            <div class="panel panel-danger">

                <div class="panel-heading">
                    <h3 class="panel-title">Delete Room</h3>
                </div>

                <div class="panel-body">

                    <div class="alert alert-warning">
                        <strong>Warning!</strong>
                        Are you sure you want to delete this room?
                    </div>

                    <p class="text-muted">
                        The following room will be permanently removed.
                    </p>

                    <dl class="dl-horizontal">

                        <dt>
                            @Html.DisplayNameFor(model => model.RoomNumber)
                        </dt>

                        <dd>
                            @Html.DisplayFor(model => model.RoomNumber)
                        </dd>

                        <dt>
                            @Html.DisplayNameFor(model => model.Capacity)
                        </dt>

                        <dd>
                            @Html.DisplayFor(model => model.Capacity)
                        </dd>

                    </dl>

                    <hr />

                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        <div>

                            <input type="submit"
                                   value="Delete Room"
                                   class="btn btn-danger" />

                            @Html.ActionLink(
                                "Cancel",
                                "Index",
                                "Rooms",
                                null,
                                new { @class = "btn btn-default" }
                            )

                        </div>
                    }

                </div>

            </div>

        </div>
    </div>

</div>