                           name="id"
                           id="deleteRoomId" />


                    <div class="details-list">

                        <div class="details-item">

                            <span class="details-label">
                                Room Name
                            </span>

                            <span class="details-value"
                                  id="deleteRoomName">
                            </span>

                        </div>


                        <div class="details-item">

                            <span class="details-label">
                                Room Number
                            </span>

                            <span class="details-value"
                                  id="deleteRoomNumber">
                            </span>

                        </div>


                        <div class="details-item">

                            <span class="details-label">
                                Room Type
                            </span>

                            <span class="details-value"
                                  id="deleteRoomType">
                            </span>

                        </div>


                        <div class="details-item">

                            <span class="details-label">
                                Capacity
                            </span>

                            <span class="details-value"
                                  id="deleteRoomCapacity">
                            </span>

                        </div>

                    </div>


                    <div class="panel-section">

                        <div class="panel-section-title">
                            Warning
                        </div>

                        <p>
                            This room will be permanently deleted from the university database.
                            This action cannot be undone.
                        </p>

                    </div>


                    <div class="edit-actions">

                        <button type="button"
                                class="edit-cancel"
                                onclick="backFromDelete()">
                            Cancel
                        </button>

                        <button type="submit"
                                class="edit-save">
                            Delete Room
                        </button>

                    </div>

                </div>}

</div>


<script>

    var isAdmin = @isAdmin.ToString().ToLower();

    /* ROOMS DATA */

    var roomsData = [

    @for (int i = 0; i < rooms.Count; i++)
    {
        var room = rooms[i];

        <text>
        {
            id:
                @room.RoomId,

            name:
                '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(room.RoomName ?? ""))',

            roomNumber:
                '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(room.RoomNumber ?? ""))',

            type:
                '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(room.RoomType ?? ""))',

            capacity:
                '@room.Capacity',

            area:
                '@room.Area',

            status:
                '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(room.Status ?? ""))',

            image:
                '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(room.ImagePath ?? ""))',

            description:
                '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(room.Description ?? ""))',

            facilities:
                '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(room.Facilities ?? ""))'
        }@(i < rooms.Count - 1 ? "," : "")
        </text>
    }

    ];


    var selectedRoom =
        null;


    /* OPEN MAIN PANEL */

    function openRoomPanel(index) {

        var room =
            roomsData[index];


        if (!room) {
            return;
        }


        selectedRoom =
            room;


        var panelImage =
            document.getElementById(
                "panelImage"
            );


        panelImage.style.display =
            "";


        if (room.image) {

            panelImage.src =
                room.image;

        }
        else {

            panelImage.removeAttribute(
                "src"
            );

            panelImage.style.display =
                "none";
        }


        document
            .getElementById(
                "panelTitle"
            )
            .innerText =
            room.name;


        document
            .getElementById(
                "panelCode"
            )
            .innerText =
            room.roomNumber;


        var panelStatus =
            document.getElementById(
                "panelStatus"
            );


        panelStatus.innerText =
            room.status;


        if (
            room.status === "In Use"
        ) {

            panelStatus
                .classList
                .add(
                    "in-use"
                );

        }
        else {

            panelStatus
                .classList
                .remove(
                    "in-use"
                );
        }


        document
            .getElementById(
                "panelType"
            )
            .innerText =
            room.type;


        document
            .getElementById(
                "panelCapacity"
            )
            .innerText =
            room.capacity;


        document
            .getElementById(
                "panelArea"
            )
            .innerText =
            room.area + " m²";


        document
            .getElementById(
                "panelCurrentStatus"
            )
            .innerText =
            room.status === "Available"
                ? "Available for use"
                : "Currently in use";


        document
            .getElementById(
                "panelDescription"
            )
            .innerText =
            room.description ||
            "No description has been added yet.";


        loadFacilities(
            "panelFacilities",
            room.facilities
        );


        closeVisiblePanels();


        document
            .getElementById(
                "roomOverlay"
            )
            .classList
            .add(
                "open"
            );


        document
            .getElementById(
                "roomPanel"
            )
            .classList
            .add(
                "open"
            );


        document.body.style.overflow =
            "hidden";
    }


    /* FACILITIES */

    function loadFacilities(
        containerId,
        facilitiesText
    ) {

        var container =
            document.getElementById(
                containerId
            );


        container.innerHTML =
            "";


        if (!facilitiesText) {

            var emptyFacility =
                document.createElement(
                    "span"
                );

            emptyFacility.className =
                "facility-tag";

            emptyFacility.innerText =
                "No facilities listed";

            container.appendChild(
                emptyFacility
            );

            return;
        }


        var facilities =
            facilitiesText.split("|");


        for (
            var i = 0;
            i < facilities.length;
            i++
        ) {

            var text =
                facilities[i].trim();


            if (text !== "") {

                var facility =
                    document.createElement(
                        "span"
                    );


                facility.className =
                    "facility-tag";


                facility.innerText =
                    text;


                container.appendChild(
                    facility
                );
            }
        }
    }


    /* EDIT */

    function openEditPanel() {

        if (!isAdmin) {
            return;
        }

        if (!selectedRoom) {
            return;
        }


        document
            .getElementById(
                "editRoomId"
            )
            .value =
            selectedRoom.id;


        document
            .getElementById(
                "editRoomName"
            )
            .value =
            selectedRoom.name;


        document
            .getElementById(
                "editRoomNumber"
            )
            .value =
            selectedRoom.roomNumber;


        setEditRoomType(
            selectedRoom.type || ""
        );


        document
            .getElementById(
                "editStatus"
            )
            .value =
            selectedRoom.status;


        document
            .getElementById(
                "editCapacity"
            )
            .value =
            selectedRoom.capacity;


        document
            .getElementById(
                "editArea"
            )
            .value =
            selectedRoom.area;


        document
            .getElementById(
                "editDescription"
            )
            .value =
            selectedRoom.description || "";


        document
            .getElementById(
                "editFacilities"
            )
            .value =
            selectedRoom.facilities || "";


        document
            .getElementById(
                "editImagePath"
            )
            .value =
            selectedRoom.image || "";


        closeVisiblePanels();


        document
            .getElementById(
                "editPanel"
            )
            .classList
            .add(
                "open"
            );
    }


    function backToDetails() {

        closeVisiblePanels();


        document
            .getElementById(
                "roomPanel"
            )
            .classList
            .add(
                "open"
            );
    }


    /* FULL DETAILS */

    function openFullDetailsPanel() {

        if (!selectedRoom) {
            return;
        }


        document
            .getElementById(
                "detailsTitle"
            )
            .innerText =
            selectedRoom.name +
            " Details";


        document
            .getElementById(
                "detailsRoomName"
            )
            .innerText =
            selectedRoom.name;


        document
            .getElementById(
                "detailsRoomNumber"
            )
            .innerText =
            selectedRoom.roomNumber;


        document
            .getElementById(
                "detailsRoomType"
            )
            .innerText =
            selectedRoom.type;


        document
            .getElementById(
                "detailsStatus"
            )
            .innerText =
            selectedRoom.status;


        document
            .getElementById(
                "detailsCapacity"
            )
            .innerText =
            selectedRoom.capacity +
            " people";


        document
            .getElementById(
                "detailsArea"
            )
            .innerText =
            selectedRoom.area +
            " m²";


        document
            .getElementById(
                "detailsDescription"
            )
            .innerText =
            selectedRoom.description ||
            "No description has been added yet.";


        document
            .getElementById(
                "detailsImagePath"
            )
            .innerText =
            selectedRoom.image ||
            "No image path";


        loadFacilities(
            "detailsFacilities",
            selectedRoom.facilities
        );


        closeVisiblePanels();


        document
            .getElementById(
                "detailsPanel"
            )
            .classList
            .add(
                "open"
            );
    }


    function backFromFullDetails() {

        closeVisiblePanels();


        document
            .getElementById(
                "roomPanel"
            )
            .classList
            .add(
                "open"
            );
    }


    /* DELETE */

    function openDeletePanel() {

        if (!isAdmin) {
            return;
        }

        if (!selectedRoom) {
            return;
        }


        document
            .getElementById(
                "deleteRoomId"
            )
            .value =
            selectedRoom.id;


        document
            .getElementById(
                "deleteRoomName"
            )
            .innerText =
            selectedRoom.name;


        document
            .getElementById(
                "deleteRoomNumber"
            )
            .innerText =
            selectedRoom.roomNumber;


        document
            .getElementById(
                "deleteRoomType"
            )
            .innerText =
            selectedRoom.type;


        document
            .getElementById(
                "deleteRoomCapacity"
            )
            .innerText =
            selectedRoom.capacity +
            " people";


        closeVisiblePanels();


        document
            .getElementById(
                "deletePanel"
            )
            .classList
            .add(
                "open"
            );
    }


    function backFromDelete() {

        closeVisiblePanels();


        document
            .getElementById(
                "roomPanel"
            )
            .classList
            .add(
                "open"
            );
    }


    /* ADD */

    function openAddPanel() {

        if (!isAdmin) {
            return;
        }

        selectedRoom =
            null;


        document
            .getElementById(
                "addRoomForm"
            )
            .reset();


        document
            .getElementById(
                "addRoomTypeValue"
            )
            .value =
            "";


        document
            .getElementById(
                "addOtherRoomType"
            )
            .value =
            "";


        updateAddRoomType();


        closeVisiblePanels();


        document
            .getElementById(
                "roomOverlay"
            )
            .classList
            .add(
                "open"
            );


        document
            .getElementById(
                "addPanel"
            )
            .classList
            .add(
                "open"
            );


        document.body.style.overflow =
            "hidden";
    }


    /* OTHER ROOM TYPE - ADD / EDIT */

    var mainRoomTypes = [
        "Lecture Hall",
        "Computer Lab",
        "Laboratory",
        "Library",
        "Meeting Room"
    ];


    function isMainRoomType(roomType) {

        return mainRoomTypes.indexOf(
            roomType
        ) !== -1;
    }


    function updateAddRoomType() {

        var select =
            document.getElementById(
                "addRoomType"
            );

        var otherField =
            document.getElementById(
                "addOtherRoomTypeField"
            );

        var otherInput =
            document.getElementById(
                "addOtherRoomType"
            );

        var hiddenValue =
            document.getElementById(
                "addRoomTypeValue"
            );


        if (
            select.value === "Other"
        ) {

            otherField.classList.add(
                "open"
            );

            otherInput.required =
                true;

            hiddenValue.value =
                otherInput.value.trim();

        }
        else {

            otherField.classList.remove(
                "open"
            );

            otherInput.required =
                false;

            otherInput.value =
                "";

            hiddenValue.value =
                select.value;
        }
    }


    function updateEditRoomType() {

        var select =
            document.getElementById(
                "editRoomType"
            );

        var otherField =
            document.getElementById(
                "editOtherRoomTypeField"
            );

        var otherInput =
            document.getElementById(
                "editOtherRoomType"
            );

        var hiddenValue =
            document.getElementById(
                "editRoomTypeValue"
            );


        if (
            select.value === "Other"
        ) {

            otherField.classList.add(
                "open"
            );

            otherInput.required =
                true;

            hiddenValue.value =
                otherInput.value.trim();

        }
        else {

            otherField.classList.remove(
                "open"
            );

            otherInput.required =
                false;

            otherInput.value =
                "";

            hiddenValue.value =
                select.value;
        }
    }


    function setEditRoomType(roomType) {

        var select =
            document.getElementById(
                "editRoomType"
            );

        var otherInput =
            document.getElementById(
                "editOtherRoomType"
            );


        if (
            isMainRoomType(
                roomType
            )
        ) {

            select.value =
                roomType;

            otherInput.value =
                "";

            updateEditRoomType();

        }
        else {

            select.value =
                "Other";

            otherInput.value =
                roomType;

            updateEditRoomType();

            otherInput.value =
                roomType;

            document
                .getElementById(
                    "editRoomTypeValue"
                )
                .value =
                roomType;
        }
    }


    document
        .getElementById(
            "addRoomType"
        )
        .addEventListener(
            "change",
            updateAddRoomType
        );


    document
        .getElementById(
            "addOtherRoomType"
        )
        .addEventListener(
            "input",
            updateAddRoomType
        );


    document
        .getElementById(
            "editRoomType"
        )
        .addEventListener(
            "change",
            updateEditRoomType
        );


    document
        .getElementById(
            "editOtherRoomType"
        )
        .addEventListener(
            "input",
            updateEditRoomType
        );


    document
        .getElementById(
            "addRoomForm"
        )
        .addEventListener(
            "submit",
            function (event) {

                updateAddRoomType();

                var roomType =
                    document
                        .getElementById(
                            "addRoomTypeValue"
                        )
                        .value
                        .trim();


                if (!roomType) {

                    event.preventDefault();

                    if (
                        document
                            .getElementById(
                                "addRoomType"
                            )
                            .value ===
                        "Other"
                    ) {

                        document
                            .getElementById(
                                "addOtherRoomType"
                            )
                            .focus();

                    }
                    else {

                        document
                            .getElementById(
                                "addRoomType"
                            )
                            .focus();
                    }
                }
            }
        );


    document
        .getElementById(
            "editRoomForm"
        )
        .addEventListener(
            "submit",
            function (event) {

                updateEditRoomType();

                var roomType =
                    document
                        .getElementById(
                            "editRoomTypeValue"
                        )
                        .value
                        .trim();


                if (!roomType) {

                    event.preventDefault();

                    if (
                        document
                            .getElementById(
                                "editRoomType"
                            )
                            .value ===
                        "Other"
                    ) {

                        document
                            .getElementById(
                                "editOtherRoomType"
                            )
                            .focus();

                    }
                    else {

                        document
                            .getElementById(
                                "editRoomType"
                            )
                            .focus();
                    }
                }
            }
        );


    /* CLOSE */

    function closeVisiblePanels() {

        document
            .getElementById(
                "roomPanel"
            )
            .classList
            .remove(
                "open"
            );


        document
            .getElementById(
                "editPanel"
            )
            .classList
            .remove(
                "open"
            );


        document
            .getElementById(
                "addPanel"
            )
            .classList
            .remove(
                "open"
            );


        document
            .getElementById(
                "detailsPanel"
            )
            .classList
            .remove(
                "open"
            );


        document
            .getElementById(
                "deletePanel"
            )
            .classList
            .remove(
                "open"
            );
    }


    function closeAllPanels() {

        closeVisiblePanels();


        document
            .getElementById(
                "roomOverlay"
            )
            .classList
            .remove(
                "open"
            );


        document.body.style.overflow =
            "";
    }


    /* ROOM FILTER MENU + MULTI CHECKBOX FILTERING */

    (function () {

        var wrap =
            document.getElementById("roomFilterWrap");

        var button =
            document.getElementById("roomFilterButton");

        var menu =
            document.getElementById("roomFilterMenu");

        var clearButton =
            document.getElementById("roomFilterClear");

        var allCheckbox =
            document.getElementById("roomFilterAll");

        var countBadge =
            document.getElementById("roomFilterCount");

        var checkboxes =
            document.querySelectorAll(
                ".room-filter-checkbox"
            );

        var cards =
            document.querySelectorAll(
                ".room-card"
            );


        function openRoomFilterMenu() {
            menu.classList.add("open");
            button.classList.add("open");
            button.setAttribute("aria-expanded", "true");
        }


        function closeRoomFilterMenu() {
            menu.classList.remove("open");
            button.classList.remove("open");
            button.setAttribute("aria-expanded", "false");
        }


        function getSelectedRoomFilters() {

            var selected = [];

            for (
                var i = 0;
                i < checkboxes.length;
                i++
            ) {

                if (
                    checkboxes[i].value !== "All" &&
                    checkboxes[i].checked
                ) {
                    selected.push(
                        checkboxes[i].value
                    );
                }
            }

            return selected;
        }


        function updateRoomFilterBadge(selected) {

            if (
                allCheckbox.checked ||
                selected.length === 0
            ) {
                countBadge.classList.remove("show");
                countBadge.textContent = "";
                return;
            }

            countBadge.textContent =
                selected.length;

            countBadge.classList.add("show");
        }


        function roomMatchesFilter(
            category,
            filter
        ) {

            var categoryLower =
                (category || "")
                    .toLowerCase();


            if (filter === "Lab") {
                return categoryLower.indexOf("lab") !== -1;
            }

            if (filter === "Lecture") {
                return categoryLower.indexOf("lecture") !== -1;
            }

            if (filter === "Library") {
                return categoryLower.indexOf("library") !== -1;
            }

            if (filter === "Meeting") {
                return categoryLower.indexOf("meeting") !== -1;
            }

            if (filter === "Other") {

                var isKnownType =
                    categoryLower.indexOf("lab") !== -1 ||
                    categoryLower.indexOf("lecture") !== -1 ||
                    categoryLower.indexOf("library") !== -1 ||
                    categoryLower.indexOf("meeting") !== -1;

                return !isKnownType;
            }

            return false;
        }


        function applyRoomFilters() {

            var selected =
                getSelectedRoomFilters();


            if (
                !allCheckbox.checked &&
                selected.length === 0
            ) {
                allCheckbox.checked = true;
            }


            if (allCheckbox.checked) {

                for (
                    var a = 0;
                    a < cards.length;
                    a++
                ) {
                    cards[a].style.display = "";
                }

                updateRoomFilterBadge([]);
                return;
            }


            for (
                var c = 0;
                c < cards.length;
                c++
            ) {

                var category =
                    cards[c]
                        .getAttribute(
                            "data-category"
                        ) || "";

                var showCard =
                    false;


                for (
                    var s = 0;
                    s < selected.length;
                    s++
                ) {

                    if (
                        roomMatchesFilter(
                            category,
                            selected[s]
                        )
                    ) {
                        showCard = true;
                        break;
                    }
                }


                cards[c].style.display =
                    showCard
                        ? ""
                        : "none";
            }


            updateRoomFilterBadge(
                selected
            );
        }


        button.addEventListener(
            "click",
            function (event) {

                event.stopPropagation();

                if (
                    menu.classList.contains("open")
                ) {
                    closeRoomFilterMenu();
                }
                else {
                    openRoomFilterMenu();
                }
            }
        );


        menu.addEventListener(
            "click",
            function (event) {
                event.stopPropagation();
            }
        );


        allCheckbox.addEventListener(
            "change",
            function () {

                if (this.checked) {

                    for (
                        var i = 0;
                        i < checkboxes.length;
                        i++
                    ) {

                        if (
                            checkboxes[i].value !== "All"
                        ) {
                            checkboxes[i].checked = false;
                        }
                    }
                }

                applyRoomFilters();
            }
        );


        for (
            var i = 0;
            i < checkboxes.length;
            i++
        ) {

            if (
                checkboxes[i].value === "All"
            ) {
                continue;
            }


            checkboxes[i]
                .addEventListener(
                    "change",
                    function () {

                        if (this.checked) {
                            allCheckbox.checked = false;
                        }

                        var selected =
                            getSelectedRoomFilters();

                        if (
                            selected.length === 0
                        ) {
                            allCheckbox.checked = true;
                        }

                        applyRoomFilters();
                    }
                );
        }


        clearButton.addEventListener(
            "click",
            function () {

                for (
                    var i = 0;
                    i < checkboxes.length;
                    i++
                ) {
                    checkboxes[i].checked =
                        checkboxes[i].value === "All";
                }

                applyRoomFilters();
            }
        );


        document.addEventListener(
            "click",
            function (event) {

                if (
                    wrap &&
                    !wrap.contains(event.target)
                ) {
                    closeRoomFilterMenu();
                }
            }
        );


        document.addEventListener(
            "keydown",
            function (event) {

                if (
                    event.key === "Escape"
                ) {

                    if (
                        menu.classList.contains("open")
                    ) {
                        closeRoomFilterMenu();
                        return;
                    }

                    closeAllPanels();
                }
            }
        );


        applyRoomFilters();

    })();

</script>