            </div>


            @if (isAdmin)
            {
<button type="button"
        class="add-room-button"
        onclick="openAddPanel()">
    Add New Room
</button>   }

        </div>


        <!-- =====================================================
             CARDS
             ===================================================== -->

        <div class="rooms-grid">

            @if (rooms.Count == 0)
            {
<div class="rooms-empty">
    No rooms have been added yet.
</div> }
else
{
for (int i = 0; i < rooms.Count; i++)
{
    var room = rooms[i];

<article class="room-card"
         data-category="@room.RoomType"
         onclick="openRoomPanel(@i)">

    <div class="room-image-wrap">

        @if (!string.IsNullOrWhiteSpace(room.ImagePath))
        {
<img class="room-image"
     src="@room.ImagePath"
     alt="@room.RoomName"
     onerror="this.style.display='none';" />}

        <div class="room-status @(room.Status == "In Use" ? "in-use" : "")">

            <span class="status-dot"></span>

            @room.Status

        </div>


        <div class="room-code">
            @room.RoomNumber
        </div>

    </div>


    <div class="room-card-content">

        <div class="room-card-top">

            <div>

                <h3 class="room-title">
                    @room.RoomName
                </h3>

                <div class="room-type">
                    @room.RoomType
                </div>

            </div>


            <div class="room-capacity">

                <span class="capacity-number">
                    @room.Capacity
                </span>

                <span class="capacity-label">
                    Capacity
                </span>

            </div>

        </div>


        <div class="room-card-footer">

            <span class="room-area-label">
                @room.Area m²
            </span>

            <span class="room-view-text">
                View Details →
            </span>

        </div>

    </div>

</article>      }
}

        </div>

    </div>

</div>


