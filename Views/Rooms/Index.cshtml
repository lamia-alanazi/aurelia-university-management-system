    #roomPanel .panel-body,
    #editPanel,
    #editPanel .edit-header,
    #editPanel .edit-body,
    #addPanel,
    #addPanel .edit-header,
    #addPanel .edit-body,
    #detailsPanel,
    #detailsPanel .edit-header,
    #detailsPanel .edit-body,
    #deletePanel,
    #deletePanel .edit-header,
    #deletePanel .edit-body {
