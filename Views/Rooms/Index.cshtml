@model IEnumerable<lamia12771.Models.Room>

@{ ViewBag.Title = "Rooms";

    var rooms = Model.ToList();

    var totalRooms = rooms.Count;
    var availableRooms = rooms.Count(r => r.Status == "Available");
    var inUseRooms = rooms.Count(r => r.Status == "In Use");

    bool isAdmin =
        Session["IsAdmin"] != null
        && Session["IsAdmin"] is bool
        && (bool)Session["IsAdmin"]; }

<style>

    /* ROOMS PAGE */

    .rooms-page {
        width: 100%;
        min-height: 100vh;
        padding: 70px 0 90px;
        background: #ffffff;
        color: #171717;
        font-family: Arial, sans-serif;
    }

    .rooms-container {
        width: 88%;
        max-width: 1380px;
        margin: 0 auto;
    }


    /* HEADER */

    .rooms-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 40px;
        padding-bottom: 32px;
        border-bottom: 1px solid #e1e3e4;
    }

    .rooms-heading-small {
        margin-bottom: 10px;
        color: #3E4348;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    .rooms-header h1 {
        margin: 0;
        font-family: 'Times New Roman', serif;
        font-size: 48px;
        font-weight: 400;
        color: #171717;
    }

    .rooms-header p {
        max-width: 500px;
        margin: 12px 0 0;
        font-size: 12px;
        line-height: 1.8;
        color: #777777;
    }


    /* SUMMARY */

    .rooms-summary {
        display: flex;
        align-items: center;
        gap: 35px;
    }

    .summary-item {
        min-width: 85px;
    }

    .summary-number {
        display: block;
        font-family: 'Times New Roman', serif;
        font-size: 32px;
        line-height: 1;
        color: #171717;
    }

    .summary-item.available .summary-number {
        color: #3E4348;
    }

    .summary-label {
        display: block;
        margin-top: 7px;
        font-size: 9px;
        letter-spacing: .8px;
        text-transform: uppercase;
        color: #888888;
    }


    /* TOOLBAR */

    .rooms-toolbar {
        margin: 34px 0 32px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 25px;
    }

    .room-filter-wrap {
        position: relative;
        display: inline-flex;
        align-items: center;
    }

    .room-filter-trigger {
        position: relative;
        width: 44px;
        height: 44px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #d8dadd;
        border-radius: 8px;
        background: #ffffff;
        color: #3E4348;
        cursor: pointer;
        transition: .25s ease;
    }

        .room-filter-trigger:hover,
        .room-filter-trigger.open {
            border-color: #3E4348;
            background: #f4f4f3;
        }

        .room-filter-trigger svg {
            width: 21px;
            height: 21px;
            display: block;
        }

    .room-filter-count {
        position: absolute;
        top: -6px;
        right: -6px;
        min-width: 18px;
        height: 18px;
        padding: 0 5px;
        display: none;
        align-items: center;
        justify-content: center;
        border: 2px solid #ffffff;
        border-radius: 20px;
        background: #3E4348;
        color: #ffffff;
        font-size: 8px;
        font-weight: 700;
        line-height: 1;
    }

        .room-filter-count.show {
            display: inline-flex;
        }

    .room-filter-menu {
        position: absolute;
        top: calc(100% + 10px);
        left: 0;
        z-index: 200;
        width: 255px;
        max-width: calc(100vw - 40px);
        padding: 15px;
        border: 1px solid #d7dadd;
        border-radius: 10px;
        background: #ffffff;
        box-shadow: 0 18px 45px rgba(32,36,40,.14);
        opacity: 0;
        visibility: hidden;
        transform: translateY(-5px);
        transition: .2s ease;
    }

        .room-filter-menu.open {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

    .room-filter-menu-head {
        margin-bottom: 10px;
        padding-bottom: 10px;
        border-bottom: 1px solid #eceeef;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .room-filter-menu-title {
        color: #3E4348;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 1.2px;
        text-transform: uppercase;
    }

    .room-filter-clear {
        padding: 0;
        border: 0;
        background: transparent;
        color: #777777;
        font-size: 9px;
        text-transform: uppercase;
        cursor: pointer;
    }

        .room-filter-clear:hover {
            color: #3E4348;
        }

    .room-filter-option {
        min-height: 36px;
        display: flex;
        align-items: center;
        gap: 10px;
        cursor: pointer;
        color: #44494d;
        font-size: 11px;
        user-select: none;
    }

        .room-filter-option + .room-filter-option {
            border-top: 1px solid #f0f1f1;
        }

        .room-filter-option input {
            position: absolute;
            opacity: 0;
            pointer-events: none;
        }

    .room-filter-check {
        width: 16px;
        height: 16px;
        flex: 0 0 16px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #bfc3c5;
        border-radius: 3px;
        background: #ffffff;
        transition: .2s ease;
    }

    .room-filter-option input:checked + .room-filter-check {
        border-color: #3E4348;
        background: #3E4348;
    }

        .room-filter-option input:checked + .room-filter-check:after {
            content: "";
            width: 7px;
            height: 4px;
            border-left: 2px solid #ffffff;
            border-bottom: 2px solid #ffffff;
            transform: rotate(-45deg) translateY(-1px);
        }

    .room-filter-option input:focus + .room-filter-check {
        box-shadow: 0 0 0 2px rgba(62,67,72,.12);
    }

    .room-filter-option-text {
        flex: 1;
        min-width: 0;
    }


    /* ADD BUTTON */

    .add-room-button {
        display: inline-block;
        padding: 11px 20px;
        background: #3E4348;
        border: 1px solid #3E4348;
        color: #ffffff;
        font-size: 10px;
        letter-spacing: .7px;
        text-transform: uppercase;
        text-decoration: none;
        cursor: pointer;
        transition: .25s ease;
    }

        .add-room-button:hover,
        .add-room-button:focus {
            background: #2F3438;
            border-color: #2F3438;
            color: #ffffff;
            text-decoration: none;
        }


    /* ROOM CARDS */

    .rooms-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 25px;
    }

    .room-card {
        position: relative;
        overflow: hidden;
        background: #ffffff;
        border: 1px solid #e1e3e4;
        cursor: pointer;
        transition: transform .3s ease, box-shadow .3s ease, border-color .3s ease;
    }

        .room-card:hover {
            transform: translateY(-6px);
            border-color: #737A80;
            box-shadow: 0 18px 45px rgba(32,36,40,.12);
        }

    .room-image-wrap {
        position: relative;
        width: 100%;
        height: 240px;
        overflow: hidden;
        background: #eeeeec;
    }

    .room-image {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
        object-position: center;
        transition: transform .45s ease;
    }

    .room-card:hover .room-image {
        transform: scale(1.035);
    }

    .room-status {
        position: absolute;
        top: 15px;
        left: 15px;
        z-index: 3;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 8px 13px;
        background: rgba(62, 67, 72, 0.94);
        border: 1px solid rgba(255, 255, 255, 0.22);
        border-radius: 7px;
        color: #ffffff;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.8px;
        text-transform: uppercase;
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.10);
    }

    .status-dot {
        display: none;
    }



    .room-code {
        position: absolute;
        right: 14px;
        bottom: 14px;
        padding: 6px 10px;
        background: rgba(27,30,34,.88);
        color: #ffffff;
        font-size: 10px;
        letter-spacing: .8px;
    }

    .room-card-content {
        padding: 20px 20px 18px;
    }

    .room-card-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 15px;
    }

    .room-title {
        margin: 0;
        font-family: 'Times New Roman', serif;
        font-size: 22px;
        font-weight: 400;
        color: #171717;
    }

    .room-type {
        margin-top: 6px;
        color: #999999;
        font-size: 9px;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .room-capacity {
        text-align: right;
    }

    .capacity-number {
        display: block;
        font-family: 'Times New Roman', serif;
        font-size: 24px;
        color: #3E4348;
    }

    .capacity-label {
        display: block;
        margin-top: 3px;
        font-size: 8px;
        letter-spacing: .8px;
        text-transform: uppercase;
        color: #999999;
    }

    .room-card-footer {
        margin-top: 17px;
        padding-top: 14px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        border-top: 1px solid #eceeef;
    }

    .room-area-label {
        font-size: 10px;
        color: #747474;
    }

    .room-view-text {
        color: #3E4348;
        font-size: 9px;
        font-weight: 600;
        letter-spacing: .8px;
        text-transform: uppercase;
    }

    .rooms-empty {
        grid-column: 1 / -1;
        padding: 70px 20px;
        text-align: center;
        border: 1px solid #e1e3e4;
        color: #777777;
    }


    /* OVERLAY */

    .room-overlay {
        position: fixed;
        inset: 0;
        z-index: 9998;
        background: rgba(10,11,13,.64);
        backdrop-filter: blur(2px);
        opacity: 0;
        visibility: hidden;
        transition: opacity .3s ease;
    }

        .room-overlay.open {
            opacity: 1;
            visibility: visible;
        }


    /* ALL PANELS - WHITE THEME */

    .room-panel,
    .edit-panel,
    .add-panel,
    .details-panel {
        position: fixed;
        top: 50%;
        left: 50%;
        z-index: 9999;
        width: 660px;
        max-width: 92%;
        max-height: 90vh;
        overflow-y: auto;
        overflow-x: hidden;
        background: #ffffff !important;
        color: #202326 !important;
        border: 1px solid #c8cbcd;
        border-radius: 18px;
        box-shadow: 0 30px 90px rgba(0,0,0,.28);
        opacity: 0;
        visibility: hidden;
        transform: translate(-50%, -47%) scale(.97);
        transition: opacity .28s ease, transform .32s ease, visibility .28s ease;
    }

        .room-panel.open,
        .edit-panel.open,
        .add-panel.open,
        .details-panel.open {
            opacity: 1;
            visibility: visible;
            transform: translate(-50%, -50%) scale(1);
        }


        /* PANEL SCROLLBAR */

        .room-panel::-webkit-scrollbar,
        .edit-panel::-webkit-scrollbar,
        .add-panel::-webkit-scrollbar,
        .details-panel::-webkit-scrollbar {
            width: 8px;
        }

        .room-panel::-webkit-scrollbar-track,
        .edit-panel::-webkit-scrollbar-track,
        .add-panel::-webkit-scrollbar-track,
        .details-panel::-webkit-scrollbar-track {
            background: transparent;
        }

        .room-panel::-webkit-scrollbar-thumb,
        .edit-panel::-webkit-scrollbar-thumb,
        .add-panel::-webkit-scrollbar-thumb,
        .details-panel::-webkit-scrollbar-thumb {
            background: #a5a9ac;
            border-radius: 20px;
        }


    /* DETAILS IMAGE */

    .panel-image-wrap {
        position: relative;
        width: 100%;
        height: 250px;
        overflow: hidden;
        background: #eeeeec;
        border-radius: 18px 18px 0 0;
    }

    .panel-image {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
        object-position: center;
    }

    .panel-close {
        position: absolute;
        z-index: 3;
        left: 20px;
        top: 20px;
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(255,255,255,.20);
        border-radius: 50%;
        background: rgba(47,52,56,.93);
        color: #ffffff;
        font-size: 23px;
        line-height: 1;
        cursor: pointer;
        transition: .2s ease;
    }

        .panel-close:hover {
            background: #202326;
            transform: scale(1.05);
        }


    /* MAIN DETAILS BODY */

    .panel-body {
        padding: 28px 30px 34px;
        background: #ffffff !important;
        color: #202326 !important;
    }

    .panel-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 24px;
    }

    .panel-heading h2 {
        margin: 0;
        font-family: 'Times New Roman', serif;
        font-size: 31px;
        font-weight: 400;
        color: #171717 !important;
    }

    .panel-code {
        margin-top: 7px;
        color: #73787c !important;
        font-size: 11px;
        letter-spacing: 1px;
    }

    .panel-status {
        padding: 8px 13px;
        border: 1px solid #d6d8da;
        border-radius: 20px;
        background: #eeeeec !important;
        color: #3E4348 !important;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: .7px;
        text-transform: uppercase;
        white-space: nowrap;
    }

        .panel-status.in-use {
            background: #e2e3e4 !important;
            color: #62676b !important;
        }


    /* ROOM STATS - GRAY BOXES */

    .panel-stats {
        margin: 26px 0 22px;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 11px;
    }

    .panel-stat {
        min-height: 90px;
        padding: 17px 10px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        background: #eeeeec !important;
        border: 1px solid #d1d4d6;
        border-radius: 12px;
    }

    .panel-stat-value {
        display: block;
        font-family: 'Times New Roman', serif;
        font-size: 23px;
        color: #171717 !important;
    }

    .panel-stat-label {
        display: block;
        margin-top: 7px;
        color: #6e7478 !important;
        font-size: 8px;
        font-weight: 600;
        letter-spacing: .8px;
        text-transform: uppercase;
    }


    /* STATUS */

    .panel-current-status {
        padding: 4px 0 22px;
        border-bottom: 1px solid #d5d7d9;
    }

    .panel-current-status-title {
        margin-bottom: 7px;
        color: #60666a !important;
        font-size: 9px;
        font-weight: 600;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .panel-current-status-value {
        color: #24282b !important;
        font-size: 13px;
    }


    /* PANEL SECTIONS */

    .panel-section {
        margin-top: 23px;
    }

    .panel-section-title {
        margin-bottom: 9px;
        color: #555b5f !important;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 1.2px;
        text-transform: uppercase;
    }

    .panel-section p {
        margin: 0;
        color: #4f5559 !important;
        font-size: 13px;
        line-height: 1.85;
    }


    /* FACILITIES */

    .panel-facilities {
        display: flex;
        flex-wrap: wrap;
        gap: 9px;
    }

    .facility-tag {
        padding: 8px 12px;
        background: #eeeeec !important;
        border: 1px solid #d1d4d6;
        border-radius: 7px;
        color: #303438 !important;
        font-size: 9px;
        font-weight: 600;
    }


    /* MAIN PANEL ACTIONS */

    .panel-actions {
        margin-top: 28px;
        padding-top: 20px;
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        border-top: 1px solid #d5d7d9;
    }

    .panel-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 11px 17px;
        border: 1px solid #c5c8ca;
        background: #ffffff;
        color: #3f4447;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: .8px;
        text-transform: uppercase;
        text-decoration: none;
        cursor: pointer;
        transition: .2s ease;
    }

        .panel-action:hover {
            border-color: #3E4348;
            color: #3E4348;
            text-decoration: none;
        }

        .panel-action.edit {
            background: #3E4348;
            border-color: #3E4348;
            color: #ffffff;
        }

            .panel-action.edit:hover {
                background: #2F3438;
                border-color: #2F3438;
                color: #ffffff;
            }


    /* ADD / EDIT / DELETE / DETAILS HEADERS */

    .edit-header {
        position: relative;
        padding: 28px 30px 23px;
        background: #ffffff !important;
        border-bottom: 1px solid #d1d4d6;
    }

    .edit-header-small {
        margin-bottom: 7px;
        color: #646a6e !important;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
    }

    .edit-header h2 {
        margin: 0;
        font-family: 'Times New Roman', serif;
        font-size: 31px;
        font-weight: 400;
        color: #171717 !important;
    }

    .edit-header p {
        max-width: 500px;
        margin: 7px 0 0;
        color: #6f7579 !important;
        font-size: 11px;
        line-height: 1.7;
    }


    /* EDIT CLOSE */

    .edit-close {
        position: absolute;
        right: 25px;
        top: 27px;
        width: 42px;
        height: 42px;
        border: 1px solid #3E4348;
        border-radius: 50%;
        background: #3E4348;
        color: #ffffff;
        font-size: 21px;
        cursor: pointer;
        transition: .2s ease;
    }

        .edit-close:hover {
            background: #2F3438;
            border-color: #2F3438;
        }


    /* FORM BODY */

    .edit-body {
        padding: 26px 30px 32px;
        background: #ffffff !important;
        color: #202326 !important;
    }

    .edit-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 17px;
    }

    .edit-field {
        display: flex;
        flex-direction: column;
        gap: 7px;
    }

        .edit-field.full {
            grid-column: 1 / -1;
        }

        .edit-field label {
            margin: 0;
            color: #555b5f !important;
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
        }


    /* FORM INPUTS - GRAY BOXES */

    .edit-input,
    .edit-select,
    .edit-textarea {
        width: 100%;
        box-sizing: border-box;
        border: 1px solid #c9ccce;
        border-radius: 8px;
        outline: none;
        background: #eeeeec !important;
        color: #202326 !important;
        font-family: Arial, sans-serif;
        font-size: 12px;
        transition: .2s ease;
    }

    .edit-input,
    .edit-select {
        height: 46px;
        padding: 0 13px;
    }

    .edit-textarea {
        min-height: 105px;
        padding: 12px 13px;
        resize: vertical;
        line-height: 1.6;
    }

        .edit-input::placeholder,
        .edit-textarea::placeholder {
            color: #8a8f93;
        }

        .edit-input:focus,
        .edit-select:focus,
        .edit-textarea:focus {
            border-color: #3E4348;
            background: #f4f4f3 !important;
            box-shadow: 0 0 0 2px rgba(62,67,72,.10);
        }

    .edit-select option {
        background: #ffffff;
        color: #171717;
    }

    .edit-help {
        margin-top: 3px;
        color: #777d81 !important;
        font-size: 8px;
        line-height: 1.5;
    }

    .room-other-type-field {
        display: none;
    }

        .room-other-type-field.open {
            display: flex;
        }



    /* FORM ACTIONS */

    .edit-actions {
        margin-top: 25px;
        padding-top: 20px;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        border-top: 1px solid #d1d4d6;
    }

    .edit-cancel,
    .edit-save {
        min-width: 115px;
        padding: 11px 18px;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: .8px;
        text-transform: uppercase;
        cursor: pointer;
        transition: .2s ease;
    }

    .edit-cancel {
        border: 1px solid #bfc3c5;
        background: #ffffff;
        color: #464b4f;
    }

        .edit-cancel:hover {
            border-color: #3E4348;
            color: #3E4348;
        }

    .edit-save {
        border: 1px solid #3E4348;
        background: #3E4348;
        color: #ffffff;
    }

        .edit-save:hover {
            background: #2F3438;
            border-color: #2F3438;
        }


    /* FULL DETAILS */

    .details-list {
        margin-top: 24px;
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
    }

    .details-item {
        padding: 15px;
        background: #eeeeec !important;
        border: 1px solid #d1d4d6;
        border-radius: 10px;
    }

        .details-item.full {
            grid-column: 1 / -1;
        }

    .details-label {
        display: block;
        margin-bottom: 7px;
        color: #666c70 !important;
        font-size: 8px;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .details-value {
        display: block;
        color: #202326 !important;
        font-size: 13px;
        line-height: 1.7;
        word-break: break-word;
    }


    /* DELETE PANEL */

    #deletePanel .panel-section {
        padding: 16px;
        background: #f4f4f3;
        border: 1px solid #d7d9db;
        border-radius: 9px;
    }

    #deletePanel .panel-section-title {
        color: #7e4444 !important;
    }

    #deletePanel .panel-section p {
        color: #44494d !important;
    }

    #deletePanel .edit-save {
        background: #b74a4a !important;
        border-color: #b74a4a !important;
        color: #ffffff !important;
    }

        #deletePanel .edit-save:hover {
            background: #9f3d3d !important;
            border-color: #9f3d3d !important;
        }


    /* FORCE WHITE PANEL THEME */

