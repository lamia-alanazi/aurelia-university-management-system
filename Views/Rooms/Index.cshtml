            text-align: center;
        }

        .room-panel,
        .edit-panel,
        .add-panel,
        .details-panel {
            width: 92%;
            max-height: 92vh;
        }
    }


    @@media (max-width: 560px) {

        .rooms-header h1 {
            font-size: 34px;
