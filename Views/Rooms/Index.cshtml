                        </span>

                        <button type="button"
                                class="room-filter-clear"
                                id="roomFilterClear">
                            Clear
                        </button>

                    </div>


                    <label class="room-filter-option">
                        <input type="checkbox"
                               class="room-filter-checkbox"
                               value="All"
                               id="roomFilterAll"
                               checked />
                        <span class="room-filter-check"></span>
                        <span class="room-filter-option-text">All Rooms</span>
                    </label>


                    <label class="room-filter-option">
                        <input type="checkbox"
                               class="room-filter-checkbox"
                               value="Lab" />
                        <span class="room-filter-check"></span>
                        <span class="room-filter-option-text">Labs</span>
                    </label>


                    <label class="room-filter-option">
                        <input type="checkbox"
                               class="room-filter-checkbox"
                               value="Lecture" />
                        <span class="room-filter-check"></span>
                        <span class="room-filter-option-text">Lecture</span>
                    </label>


                    <label class="room-filter-option">
                        <input type="checkbox"
                               class="room-filter-checkbox"
                               value="Library" />
                        <span class="room-filter-check"></span>
                        <span class="room-filter-option-text">Library</span>
                    </label>


                    <label class="room-filter-option">
                        <input type="checkbox"
                               class="room-filter-checkbox"
                               value="Meeting" />
                        <span class="room-filter-check"></span>
                        <span class="room-filter-option-text">Meeting</span>
                    </label>


                    <label class="room-filter-option">
                        <input type="checkbox"
                               class="room-filter-checkbox"
                               value="Other" />
                        <span class="room-filter-check"></span>
                        <span class="room-filter-option-text">Other</span>
                    </label>

