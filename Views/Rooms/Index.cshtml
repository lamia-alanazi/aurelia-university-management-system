                        aria-expanded="false"
                        aria-controls="roomFilterMenu">

                    <svg viewBox="0 0 24 24"
                         aria-hidden="true">
                        <path d="M4 5h16l-6.3 7.1v5.2l-3.4 1.8v-7L4 5z"
