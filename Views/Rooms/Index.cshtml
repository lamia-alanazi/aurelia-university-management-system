        .room-panel,
        .edit-panel,
        .add-panel,
        .details-panel {
            width: 95%;
            border-radius: 14px;
        }

        .panel-image-wrap {
            height: 210px;
            border-radius: 14px 14px 0 0;
        }

        .panel-body,
        .edit-body {
            padding: 24px 20px 30px;
        }

        .panel-stats,
        .edit-grid,
        .details-list {
            grid-template-columns: 1fr;
        }

        .edit-field.full,
        .details-item.full {
            grid-column: auto;
        }

        .panel-actions,
