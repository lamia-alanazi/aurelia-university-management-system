                        <path d="M16.5 8.5h3.5M15.5 12h4.5M17 15.5h3"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="1.8"
                              stroke-linecap="round" />
                    </svg>

                    <span class="room-filter-count"
                          id="roomFilterCount">
                    </span>

                </button>


